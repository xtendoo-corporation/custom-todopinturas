<odoo>
    <menuitem id="menu_todopintura_root" name="Todo Pintura" sequence="1"/>

    <record id="action_sale_session_kanban" model="ir.actions.act_window">
        <field name="name">Tablero</field>
        <field name="res_model">sale.session</field>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="view_sale_session_kanban"/>
    </record>

    <record id="action_sale_session_history" model="ir.actions.act_window">
        <field name="name">Historial de Sesiones</field>
        <field name="res_model">sale.session.history</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_sale_session_root" name="Tablero" parent="menu_todopintura_root" sequence="1"
              action="action_sale_session_kanban"/>

    <menuitem id="menu_sale_session_history" name="Historial de Sesiones" parent="menu_sale_session_root" sequence="2"
              action="action_sale_session_history"/>

    <record id="action_open_sale_order_employee_wizard" model="ir.actions.act_window">
        <field name="name">Presupuesto con PIN</field>
        <field name="res_model">sale.order.employee.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{}</field>
    </record>
</odoo>

<odoo>
    <record id="view_close_sale_session_wizard_form" model="ir.ui.view">
        <field name="name">close.sale.session.wizard.form</field>
        <field name="model">close.sale.session.wizard</field>
        <field name="arch" type="xml">
            <form string="Cerrar Caja de Ventas">
                <group>
                    <field name="sale_session_id" readonly="1"/>
                    <field name="initial_amount" readonly="1"/>
                    <field name="final_amount"/>
                </group>
                <footer>
                    <button string="Cerrar Caja" type="object" name="action_close_sale_box" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

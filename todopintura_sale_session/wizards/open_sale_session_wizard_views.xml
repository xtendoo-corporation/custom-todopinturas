<odoo>
    <record id="view_open_sale_session_wizard_form" model="ir.ui.view">
        <field name="name">open.sale.session.wizard.form</field>
        <field name="model">open.sale.session.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="sale_session_id" invisible="1"/>
                    <field name="initial_amount"/>
                </group>
                <footer>
                    <button string="Abrir Caja" type="object" name="action_open_session" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

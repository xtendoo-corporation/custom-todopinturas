<odoo>
    <record id="view_sale_order_employee_wizard_form" model="ir.ui.view">
        <field name="name">sale.order.employee.wizard.form</field>
        <field name="model">sale.order.employee.wizard</field>
        <field name="arch" type="xml">
            <form string="Seleccionar Empleado y PIN">
                <group>
                    <field name="employee_id"/>
                    <field name="pin" password="True"/>
                </group>
                <footer>
                    <button string="Confirmar" type="object" name="action_confirm" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

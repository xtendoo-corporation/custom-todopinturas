<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Líneas del traslado: existencias del destino, mínimo y cantidad a enviar. -->
    <record id="view_picking_form_tp_min_lines" model="ir.ui.view">
        <field name="name">stock.picking.form.todopintura.min.lines</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids']/list/field[@name='product_id']" position="after">
                <field name="tp_dest_qty" optional="show"/>
                <field name="tp_min_qty" optional="show"/>
                <field name="tp_to_send" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Plantilla principal del documento para ventas a crédito -->
    <template id="report_sale_credit_document">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-set="o" t-value="o.with_context(lang=o._get_report_lang())"/>
                <t t-set="partner" t-value="o.partner_id or (o.move_ids and o.move_ids[0].partner_id) or False"/>

                <t t-set="address">
                    <div name="div_outgoing_address">
                        <div name="outgoing_delivery_address" t-if="o.should_print_delivery_address()">
                            <span>
                                <strong>Dirección de Entrega:</strong>
                            </span>
                            <div t-out="o.move_ids[0].partner_id or o.partner_id"
                                 t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'/>
                        </div>
                        <div name="outgoing_warehouse_address"
                             t-elif="o.picking_type_id.code != 'internal' and o.picking_type_id.warehouse_id.partner_id">
                            <strong>Dirección del Almacén</strong>
                            <div t-field="o.picking_type_id.warehouse_id.partner_id"
                                 t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'/>
                        </div>
                    </div>
                </t>
                <t t-set="information_block">
                    <div class="row">
                        <div class="col-7" name="div_incoming_address">
                            <t t-set="show_partner" t-value="False"/>
                            <div name="vendor_address" t-if="o.picking_type_id.code=='incoming' and partner">
                                <strong>Dirección de Proveedor</strong>
                                <t t-set="show_partner" t-value="True"/>
                            </div>
                            <div name="customer_address"
                                 t-if="o.picking_type_id.code=='outgoing' and partner and partner != partner.commercial_partner_id">
                                <strong>Dirección de Cliente</strong>
                                <t t-set="show_partner" t-value="True"/>
                            </div>
                            <div t-if="show_partner" name="partner_header">
                                <div t-field="partner.commercial_partner_id"
                                     t-options='{"widget": "contact", "fields": ["address", "name", "phone", "vat"], "no_marker": True, "phone_icons": True}'/>
                            </div>
                        </div>
                    </div>
                </t>
                <div class="page">
                    <h2>
                        <t t-if="o.name">
                            <t t-if="o.partner_id.credit_sale">
                                <span t-esc="'Venta a crédito Nº ' + o.name.split('/')[-1]"/>
                            </t>
                            <t t-else="">
                                <span t-esc="'ALBARÁN Nº ' + o.name.split('/')[-1]"/>
                            </t>
                        </t>
                        <t t-else="">
                            <span t-field="o.name"/>
                        </t>
                    </h2>

                    <!-- Información principal -->
                    <div class="row mb-4 border-bottom pb-2">
                        <div class="col-6">
                            <strong>Cliente:</strong>
                            <span t-field="o.partner_id.name"/>
                        </div>
                        <div t-if="o.sale_id" class="col-6">
                            <strong>Condiciones de pago:</strong>
                            <span t-field="o.sale_id.payment_term_id.name"/>
                        </div>
                    </div>

                    <div class="oe_structure"></div>
                    <div id="informations" class="report-wrapping-flexbox clearfix row mb-4">
                        <div t-if="o.origin" class="col col-3 mw-100 mb-2" name="div_origin">
                            <strong>Pedido</strong>
                            <div t-field="o.origin" class="m-0"></div>
                        </div>
                        <div t-if="o.state" class="col col-3 mw-100 mb-2" name="div_sched_date">
                            <strong>Fecha de Entrega</strong>
                            <div t-if="o.state == 'done'" t-field="o.date_done" class="m-0"/>
                            <div t-else="" t-field="o.scheduled_date" class="m-0"/>
                        </div>
                    </div>
                    <div class="oe_structure"></div>

                    <!-- Tabla para albarán en proceso -->
                    <table class="table table-borderless" t-if="o.state!='done'" name="stock_move_table">
                        <thead>
                            <tr>
                                <th name="th_sm_product">Producto</th>
                                <th name="th_sm_ordered" class="text-end">Unidades</th>
                                <t t-if="o.partner_id.valued_picking">
                                    <th class="text-center">Precio</th>
                                    <th class="text-center">Total</th>
                                </t>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="lines" t-value="o.move_ids.filtered(lambda x: x.product_uom_qty)"/>
                            <tr t-foreach="lines" t-as="move">
                                <td class="py-1">
                                    <span t-field="move.product_id"/>
                                    <p t-if="move.description_picking and move.description_picking != move.product_id.name and move.description_picking != move.product_id.display_name">
                                        <span t-field="move.description_picking"/>
                                    </p>
                                </td>
                                <td class="text-end py-1">
                                    <span t-field="move.product_uom_qty"/>
                                    <span t-field="move.product_uom" groups="uom.group_uom"/>
                                </td>
                                <t t-if="o.partner_id.valued_picking">
                                    <td class="text-end py-1">
                                        <t t-set="price_unit"
                                           t-value="move.sale_line_id.price_unit if move.sale_line_id else 0.0"/>
                                        <t t-set="discount"
                                           t-value="move.sale_line_id.discount if move.sale_line_id else 0.0"/>
                                        <t t-set="price_with_discount"
                                           t-value="price_unit * (1 - discount / 100) if discount else price_unit"/>
                                        <span t-esc="price_with_discount"
                                              t-options='{"widget": "monetary", "display_currency": env.company.currency_id}'/>
                                    </td>
                                    <td class="text-end py-1">
                                        <span t-esc="price_with_discount * move.product_uom_qty"
                                              t-options='{"widget": "monetary", "display_currency": env.company.currency_id}'/>
                                    </td>
                                </t>
                            </tr>
                        </tbody>
                    </table>

                    <!-- Tabla para albarán completado -->
                    <table class="table table-borderless mt48" t-elif="o.move_line_ids and o.state=='done'"
                           name="stock_move_line_table">
                        <t t-set="has_serial_number" t-value="False"/>
                        <t t-set="has_serial_number" t-value="o.move_line_ids.mapped('lot_id')"
                           groups="stock.group_lot_on_delivery_slip"/>
                        <thead>
                            <tr>
                                <th name="th_sml_product">Producto</th>
                                <th name="th_sml_qty_ordered" class="text-center" t-if="not has_serial_number">
                                    Solicitado
                                </th>
                                <th name="lot_serial" t-else="">Lote/Número de Serie</th>
                                <th name="th_sml_quantity" class="text-center">Entregado</th>
                                <t t-if="o.partner_id.valued_picking">
                                    <th class="text-center">Precio Unitario</th>
                                    <th class="text-center">Total</th>
                                </t>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="has_packages" t-value="o.move_line_ids.mapped('result_package_id')"/>
                            <t t-if="has_packages" name="has_packages">
                                <t t-set="packages" t-value="has_packages"/>
                                <t t-foreach="packages" t-as="package">
                                    <!-- Llamadas a bloques correspondientes por paquete -->
                                </t>
                                <t t-set="move_lines"
                                   t-value="o.move_line_ids.filtered(lambda l: not l.result_package_id)"/>
                                <t t-set="aggregated_lines"
                                   t-value="o.move_line_ids._get_aggregated_product_quantities(except_package=True)"/>
                                <t t-if="move_lines or aggregated_lines" name="no_package_move_lines">
                                    <!-- Llamadas a bloques correspondientes para líneas sin paquete -->
                                </t>
                            </t>
                            <t t-else="">
                                <t t-if="has_serial_number">
                                    <tr t-foreach="o.move_line_ids" t-as="move_line">
                                        <!-- Llamada al bloque correspondiente -->
                                    </tr>
                                </t>
                                <t t-else="" name="aggregated_move_lines">
                                    <tr t-foreach="o.move_ids.filtered(lambda x: x.product_uom_qty)" t-as="move">
                                        <td>
                                            <span t-field="move.product_id"/>
                                            <p t-if="move.description_picking and move.description_picking != move.product_id.name and move.description_picking != move.product_id.display_name">
                                                <span t-field="move.description_picking"/>
                                            </p>
                                        </td>
                                        <td class="text-center">
                                            <span t-field="move.product_uom_qty"/>
                                            <span t-field="move.product_uom" groups="uom.group_uom"/>
                                        </td>
                                        <td class="text-center">
                                            <span t-field="move.quantity"/>
                                            <span t-field="move.product_uom" groups="uom.group_uom"/>
                                        </td>
                                        <t t-if="o.partner_id.valued_picking">
                                            <td class="text-center">
                                                <t t-set="price_unit"
                                                   t-value="move.sale_line_id.price_unit if move.sale_line_id else 0.0"/>
                                                <t t-set="discount"
                                                   t-value="move.sale_line_id.discount if move.sale_line_id else 0.0"/>
                                                <t t-set="price_with_discount"
                                                   t-value="price_unit * (1 - discount / 100) if discount else price_unit"/>
                                                <span t-esc="price_with_discount"
                                                      t-options='{"widget": "monetary", "display_currency": env.company.currency_id}'/>
                                            </td>
                                            <td class="text-center">
                                                <span t-esc="price_with_discount * move.quantity"
                                                      t-options='{"widget": "monetary", "display_currency": env.company.currency_id}'/>
                                            </td>
                                        </t>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>
                    <div class="oe_structure"></div>
                    <t t-set="backorders"
                       t-value="o.backorder_ids.filtered(lambda x: x.state not in ('done', 'cancel'))"/>
                    <div t-if="not (o.backorder_ids and backorders)" class="oe_structure"></div>
                    <div t-else="">
                        <p class="mt-5">
                            <span>Cantidades pendientes de entrega:</span>
                        </p>
                        <table class="table table-borderless" name="stock_backorder_table">
                            <thead>
                                <tr>
                                    <th name="th_sb_product">
                                        <strong>Producto</strong>
                                    </th>
                                    <th/>
                                    <th name="th_sb_quantity" class="text-center">
                                        <strong>Cantidad</strong>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="backorders.mapped('move_ids').filtered(lambda x: x.product_uom_qty)"
                                    t-as="bo_line">
                                    <td class="w-auto">
                                        <span t-field="bo_line.product_id"/>
                                        <p t-if="bo_line.description_picking and bo_line.description_picking != bo_line.product_id.name and bo_line.description_picking != bo_line.product_id.display_name">
                                            <span t-field="bo_line.description_picking"/>
                                        </p>
                                    </td>
                                    <td/>
                                    <td class="text-center w-auto">
                                        <span t-field="bo_line.product_uom_qty"/>
                                        <span t-field="bo_line.product_uom" groups="uom.group_uom"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                </div>
                <!-- Sección para mostrar el total con margen superior -->
                <div class="clearfix">
                    <div class="row" t-if="o.partner_id.valued_picking">
                        <div class="col-6">
                            <!-- Columna izquierda vacía para alineación -->
                        </div>
                        <div class="col-6">
                            <div class="table-responsive">
                                <table class="table table-sm" style="page-break-inside: avoid;">
                                    <tr class="border-black">
                                        <td class="text-end">
                                            <strong>Subtotal</strong>
                                        </td>
                                        <td class="text-end">
                                            <t t-set="total_amount" t-value="0.0"/>

                                            <!-- Cálculo del total para cualquier estado del albarán -->
                                            <t t-if="o.state!='done'">
                                                <t t-foreach="o.move_ids.filtered(lambda x: x.product_uom_qty)"
                                                   t-as="move">
                                                    <t t-set="price_unit"
                                                       t-value="move.sale_line_id.price_unit if move.sale_line_id else 0.0"/>
                                                    <t t-set="discount"
                                                       t-value="move.sale_line_id.discount if move.sale_line_id else 0.0"/>
                                                    <t t-set="price_with_discount"
                                                       t-value="price_unit * (1 - discount / 100) if discount else price_unit"/>
                                                    <t t-set="total_amount"
                                                       t-value="total_amount + (price_with_discount * move.product_uom_qty)"/>
                                                </t>
                                            </t>
                                            <t t-elif="o.move_line_ids and o.state=='done'">
                                                <t t-foreach="o.move_ids.filtered(lambda x: x.product_uom_qty)"
                                                   t-as="move">
                                                    <t t-set="price_unit"
                                                       t-value="move.sale_line_id.price_unit if move.sale_line_id else 0.0"/>
                                                    <t t-set="discount"
                                                       t-value="move.sale_line_id.discount if move.sale_line_id else 0.0"/>
                                                    <t t-set="price_with_discount"
                                                       t-value="price_unit * (1 - discount / 100) if discount else price_unit"/>
                                                    <t t-set="total_amount"
                                                       t-value="total_amount + (price_with_discount * move.product_uom_qty)"/>
                                                </t>
                                            </t>

                                            <span t-esc="total_amount"
                                                  t-options='{"widget": "monetary", "display_currency": env.company.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="text-end">
                                            <strong>IVA (21%)</strong>
                                        </td>
                                        <td class="text-end">
                                            <span t-esc="total_amount * 0.21"
                                                  t-options='{"widget": "monetary", "display_currency": env.company.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr class="border-black o_total">
                                        <td class="text-end">
                                            <strong>Total con IVA</strong>
                                        </td>
                                        <td class="text-end">
                                            <span t-esc="total_amount * 1.21"
                                                  t-options='{"widget": "monetary", "display_currency": env.company.currency_id}'/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>

    <template id="report_sale_credit_slip">
        <t t-foreach="docs" t-as="o">
            <t t-set="company" t-value="o.company_id"/>
            <t t-set="display_address" t-value="o.partner_id._display_address()"/>
            <html>
                <head>
                </head>
                <body>
                    <!-- Se llama al template base (header y footer) -->
                    <t t-call="todopintura_administration.report_delivery_header_footer"/>
                    <!-- Contenedor del contenido del albarán -->
                    <main>
                        <div class="page-content" style="margin-top: 120px;">
                            <t t-call="todopintura_pos_custom.report_sale_credit_document"
                               t-lang="o._get_report_lang()"/>
                        </div>
                    </main>
                </body>
            </html>
        </t>
    </template>

    <!-- Registro del informe en el sistema -->
    <record id="action_report_sale_credit" model="ir.actions.report">
        <field name="name">Albarán de Venta a Crédito</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">todopintura_pos_custom.report_sale_credit_slip</field>
        <field name="report_file">todopintura_pos_custom.report_sale_credit_slip</field>
        <field name="print_report_name">'Albarán Crédito - %s - %s' % (object.partner_id.name or '', object.name)
        </field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
    </record>
</odoo>

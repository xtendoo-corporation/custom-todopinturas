<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Plantilla principal del documento para ventas a crédito -->
    <template id="report_sale_credit_document">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-set="o" t-value="o.with_context(lang=o._get_report_lang())" />
                <t t-set="partner" t-value="o.partner_id or (o.move_ids and o.move_ids[0].partner_id) or False"/>

                <!-- Marca distintiva de Venta a Crédito -->
                <div class="alert alert-warning text-center mb-3">
                    <strong style="font-size: 18px;">VENTA A CRÉDITO</strong>
                </div>

                <t t-set="address">
                    <div name="div_outgoing_address">
                        <div name="outgoing_delivery_address"
                            t-if="o.should_print_delivery_address()">
                            <span><strong>Dirección de Entrega:</strong></span>
                            <div t-out="o.move_ids[0].partner_id or o.partner_id"
                                t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'/>
                        </div>
                        <div name="outgoing_warehouse_address"
                             t-elif="o.picking_type_id.code != 'internal' and o.picking_type_id.warehouse_id.partner_id">
                            <strong>Dirección del Almacén</strong>
                            <div t-field="o.picking_type_id.warehouse_id.partner_id"
                                t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'/>
                        </div>
                    </div>
                </t>
                <t t-set="information_block">
                    <div class="row">
                        <div class="col-7" name="div_incoming_address">
                            <t t-set="show_partner" t-value="False" />
                            <div name="vendor_address" t-if="o.picking_type_id.code=='incoming' and partner">
                                <strong>Dirección de Proveedor</strong>
                                <t t-set="show_partner" t-value="True" />
                            </div>
                            <div name="customer_address" t-if="o.picking_type_id.code=='outgoing' and partner and partner != partner.commercial_partner_id">
                                <strong>Dirección de Cliente</strong>
                                <t t-set="show_partner" t-value="True" />
                            </div>
                            <div t-if="show_partner" name="partner_header">
                                <div t-field="partner.commercial_partner_id"
                                     t-options='{"widget": "contact", "fields": ["address", "name", "phone", "vat"], "no_marker": True, "phone_icons": True}'/>
                            </div>
                        </div>
                    </div>
                </t>
                <div class="page">
                    <h2>
                        <span t-field="o.name"></span>
                    </h2>

                    <!-- Información adicional sobre la venta a crédito -->
                    <div class="row mb-4 border-bottom pb-2">
                        <div class="col-6">
                            <strong>Cliente:</strong> <span t-field="o.partner_id.name"/>
                        </div>
                        <div t-if="o.sale_id" class="col-6">
                            <strong>Condiciones de pago:</strong>
                            <span t-field="o.sale_id.payment_term_id.name"/>
                        </div>
                    </div>

                    <div class="oe_structure"></div>
                    <div id="informations" class="report-wrapping-flexbox clearfix row mb-4">
                        <div t-if="o.origin" class="col col-3 mw-100 mb-2" name="div_origin">
                            <strong>Pedido</strong>
                            <div t-field="o.origin" class="m-0"></div>
                        </div>
                        <div t-if="o.state" class="col col-3 mw-100 mb-2" name="div_sched_date">
                            <strong>Fecha de Entrega</strong>
                            <div t-if="o.state == 'done'" t-field="o.date_done" class="m-0"/>
                            <div t-else="" t-field="o.scheduled_date" class="m-0"/>
                        </div>
                    </div>
                    <div class="oe_structure"></div>
                    <table class="table table-borderless" t-if="o.state!='done'" name="stock_move_table">
                        <thead>
                            <tr>
                                <th name="th_sm_product">Producto</th>
                                <th name="th_sm_ordered" class="text-end">Solicitado</th>
                                <th name="th_sm_quantity" class="text-end">Entregado</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="lines" t-value="o.move_ids.filtered(lambda x: x.product_uom_qty)"/>
                            <tr t-foreach="lines" t-as="move">
                                <td>
                                    <span t-field="move.product_id"></span>
                                    <p t-if="move.description_picking and move.description_picking != move.product_id.name and move.description_picking != move.product_id.display_name">
                                        <span t-field="move.description_picking"></span>
                                    </p>
                                </td>
                                <td class="text-end">
                                    <span t-field="move.product_uom_qty"></span>
                                    <span t-field="move.product_uom" groups="uom.group_uom"></span>
                                    <span t-if="move.product_packaging_id">
                                        (<span t-field="move.product_packaging_qty" t-options='{"widget": "integer"}'/> <span t-field="move.product_packaging_id"/>)
                                    </span>
                                </td>
                                <td class="text-end">
                                    <span t-field="move.quantity"></span>
                                    <span t-field="move.product_uom" groups="uom.group_uom"></span>
                                    <span t-if="move.product_packaging_id">
                                        (<span t-field="move.product_packaging_quantity" t-options='{"widget": "integer"}'/> <span t-field="move.product_packaging_id"/>)
                                    </span>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <table class="table table-borderless mt48" t-elif="o.move_line_ids and o.state=='done'" name="stock_move_line_table">
                        <t t-set="has_serial_number" t-value="False"/>
                        <t t-set="has_serial_number" t-value="o.move_line_ids.mapped('lot_id')" groups="stock.group_lot_on_delivery_slip"/>
                        <thead>
                            <tr>
                                <th name="th_sml_product">Producto</th>
                                <th name="th_sml_qty_ordered" class="text-center" t-if="not has_serial_number">Solicitado</th>
                                <th name="lot_serial" t-else="">Lote/Número de Serie</th>
                                <th name="th_sml_quantity" class="text-center">Entregado</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="o.has_packages" name="has_packages">
                                <t t-set="packages" t-value="o.move_line_ids.mapped('result_package_id')"/>
                                <t t-foreach="packages" t-as="package">
                                    <t t-call="stock.stock_report_delivery_package_section_line"/>
                                    <t t-set="package_move_lines" t-value="o.move_line_ids.filtered(lambda l: l.result_package_id == package)"/>
                                    <t t-if="has_serial_number">
                                        <tr t-foreach="package_move_lines" t-as="move_line">
                                            <t t-call="stock.stock_report_delivery_has_serial_move_line"/>
                                        </tr>
                                    </t>
                                    <t t-else="">
                                        <t t-set="aggregated_lines" t-value="package_move_lines._get_aggregated_product_quantities(strict=True)"/>
                                        <t t-call="stock.stock_report_delivery_aggregated_move_lines"/>
                                    </t>
                                </t>
                                <t t-set="move_lines" t-value="o.move_line_ids.filtered(lambda l: not l.result_package_id)"/>
                                <t t-set="aggregated_lines" t-value="o.move_line_ids._get_aggregated_product_quantities(except_package=True)"/>
                                <t t-if="move_lines or aggregated_lines" name="no_package_move_lines">
                                    <t t-call="stock.stock_report_delivery_no_package_section_line" name="no_package_section"/>
                                    <t t-if="has_serial_number">
                                        <tr t-foreach="move_lines" t-as="move_line">
                                            <t t-call="stock.stock_report_delivery_has_serial_move_line"/>
                                        </tr>
                                    </t>
                                    <t t-elif="aggregated_lines">
                                        <t t-call="stock.stock_report_delivery_aggregated_move_lines"/>
                                    </t>
                                </t>
                            </t>
                            <t t-else="">
                                <t t-if="has_serial_number">
                                    <tr t-foreach="o.move_line_ids" t-as="move_line">
                                        <t t-call="stock.stock_report_delivery_has_serial_move_line"/>
                                    </tr>
                                </t>
                                <t t-else="" name="aggregated_move_lines">
                                    <t t-set="aggregated_lines" t-value="o.move_line_ids._get_aggregated_product_quantities()"/>
                                    <t t-call="stock.stock_report_delivery_aggregated_move_lines"/>
                                </t>
                            </t>
                        </tbody>
                    </table>

                    <!-- Información adicional para backorders -->
                    <div class="oe_structure"></div>
                    <t t-set="backorders" t-value="o.backorder_ids.filtered(lambda x: x.state not in ('done', 'cancel'))"/>
                    <div t-if="not (o.backorder_ids and backorders)" class="oe_structure"></div>
                    <div t-else="">
                        <p class="mt-5">
                            <span>Cantidades pendientes de entrega:</span>
                        </p>
                        <table class="table table-borderless" name="stock_backorder_table">
                            <thead>
                                <tr>
                                    <th name="th_sb_product"><strong>Producto</strong></th>
                                    <th/>
                                    <th name="th_sb_quantity" class="text-center"><strong>Cantidad</strong></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="backorders.mapped('move_ids').filtered(lambda x: x.product_uom_qty)" t-as="bo_line">
                                    <td class="w-auto">
                                        <span t-field="bo_line.product_id"></span>
                                        <p t-if="bo_line.description_picking and bo_line.description_picking != bo_line.product_id.name and bo_line.description_picking != bo_line.product_id.display_name">
                                            <span t-field="bo_line.description_picking"></span>
                                        </p>
                                    </td>
                                    <td/>
                                    <td class="text-center w-auto">
                                        <span t-field="bo_line.product_uom_qty"></span>
                                        <span t-field="bo_line.product_uom" groups="uom.group_uom"></span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Sección para confirmación de pago a crédito -->
                    <div class="alert alert-info mt-4 mb-4">
                        <p class="mb-0">
                            <strong>Confirmo recibir esta mercancía a crédito y me comprometo a realizar el pago según las condiciones acordadas.</strong>
                        </p>
                    </div>

                    <!-- Sección de firma -->
                    <div class="row mt-5">
                        <div class="col-6 text-center">
                            <div>
                                <strong>Firma del Cliente:</strong>
                                <div t-if="o.signature" class="mt-2">
                                    <img t-att-src="image_data_uri(o.signature)" style="max-height: 4cm; max-width: 8cm;"/>
                                </div>
                                <div t-else="" style="border-top: 1px solid black; margin-top: 70px;"></div>
                                <div t-if="o.partner_id.name" class="mt-2">
                                    <p t-field="o.partner_id.name"></p>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 text-center">
                            <div>
                                <strong>Firma de Entrega:</strong>
                                <div style="border-top: 1px solid black; margin-top: 70px;"></div>
                                <p class="mt-2">Representante de la empresa</p>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
         </t>
    </template>

    <!-- Plantilla para el informe completo que itera sobre documentos -->
    <template id="report_sale_credit_slip">
        <t t-foreach="docs" t-as="o">
            <t t-call="todopintura_pos_custom.report_sale_credit_document" t-lang="o._get_report_lang()"/>
        </t>
    </template>

    <!-- Registro del informe en el sistema -->
    <record id="action_report_sale_credit" model="ir.actions.report">
        <field name="name">Albarán de Venta a Crédito</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">todopintura_pos_custom.report_sale_credit_slip</field>
        <field name="report_file">todopintura_pos_custom.report_sale_credit_slip</field>
        <field name="print_report_name">'Albarán Crédito - %s - %s' % (object.partner_id.name or '', object.name)</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
    </record>
</odoo>

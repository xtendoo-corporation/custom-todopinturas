<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t t-name="gomez_pos_custom.ReceiptHeader" t-inherit="point_of_sale.ReceiptHeader" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-receipt-contact')]" position="replace">
            <div class="custom-header"
                 style="font-family: 'Courier New', monospace; font-weight: bold; letter-spacing: 0.5px; text-align: center;">
                <t t-set="isSimplifiedInvoice" t-value="props.data.is_l10n_es_simplified_invoice"/>
                <t t-if="props.data.is_spanish">
                    <t t-if="isSimplifiedInvoice">
                        <div>Factura simplificada</div>
                        <div class="simplified-invoice-number" t-esc="props.data.invoice_name"/>
                        <div>
                            <t t-set="now" t-value="new Date().toLocaleString('es-ES', { dateStyle: 'short', timeStyle: 'short' })"/>
                            Fecha:
                            <t t-esc="now"/>
                        </div>
                    </t>
                    <div t-if="props.data.company.name" t-esc="props.data.company.name"/>
                    <div t-if="props.data.company.vat">NIF: <t t-esc="props.data.company.vat"/></div>
                    <div t-if="props.data.company.street" t-esc="props.data.company.street"/>
                    <div t-if="props.data.company.zip" t-esc="props.data.company.zip"/>
                    <span style="display: inline; white-space: nowrap;">
                        <t t-esc="(props.data.company.city || '') + (props.data.company.state_id ? ' (' + (props.data.company.state_id.name || '') + ')' : '')"/>
                    </span>



                </t>
                <t t-set="partner" t-value="props.data.partner"/>
                <t t-if="props.data.is_spanish and partner and partner.id !== props.data.simplified_partner_id and partner.name">
                    <div>Cliente: <t t-esc="partner.name"/></div>
                    <div t-if="partner.vat">NIF: <t t-esc="partner.vat"/></div>
                    <div t-if="partner.street" t-esc="partner.street"/>
                    <div t-if="partner.zip" t-esc="partner.zip"/>
                    <span style="display: inline; white-space: nowrap;">
                        <t t-esc="(partner.city || '') + (partner.state_id ? ' (' + (partner.state_id.name || '') + ')' : '')"/>
                    </span>
                </t>
            </div>
        </xpath>
    </t>
</templates>

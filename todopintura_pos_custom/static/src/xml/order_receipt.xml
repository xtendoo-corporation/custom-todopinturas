<templates id="template" xml:space="preserve">
        <t t-name="todopintura_pos_custom.OrderReceipt" t-inherit="point_of_sale.OrderReceipt"
           t-inherit-mode="extension">
        <xpath
            expr="(//div[contains(@class, 'pos-receipt-order-data')])[6]"
            position="replace">
            <div class="pos-receipt-order-data">
                <p>No se admiten devolucion pasados 30 dias de la fecha del ticket
                   No se admite devolucion de colores hechos en la máquina
                </p>
                <p>GRACIAS POR SU VISITA</p>
                <div t-esc="props.data.name"/>
                <div id="order-date" t-esc="props.data.date"/>
            </div>
        </xpath>
            <!-- Para aplicar el estilo a todo el recibo -->
              <xpath expr="//div[contains(@class, 'pos-receipt') and contains(@class, 'p-2')]" position="attributes">
            <attribute name="style">font-family: 'Courier New', monospace; font-weight: bold; letter-spacing: 0.5px; text-align: center;</attribute>
    </xpath>


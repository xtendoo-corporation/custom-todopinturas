<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="todopintura_pos_custom.ProductInfoPopup" t-inherit="point_of_sale.ProductInfoPopup" t-inherit-mode="primary">
         <xpath expr="//div[hasclass('section-inventory-body')]" position="replace">
            <div class="section-inventory-body">
                <t t-foreach="props.info.productInfo.warehouses" t-as="location" t-key="location.name">
                    <div class="d-flex flex-column flex-md-row gap-2">
                        <div>
                            <t t-esc="location.name" class="table-name"/>:
                        </div>
                        <div>
                            <span class="me-1 fw-bolder"><t t-esc="location.available_quantity" class="table-name"/></span>
                            <t t-esc="location.uom"/> disponible
                        </div>
                    </div>
                </t>
            </div>
        </xpath>

        <xpath expr="//div[hasclass('section-supplier')]" position="replace">
        </xpath>
        <xpath expr="//div[hasclass('financials-order')]" position="replace">
        </xpath>
    </t>
</templates>

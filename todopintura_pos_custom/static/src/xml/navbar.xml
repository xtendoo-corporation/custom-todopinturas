<templates xml:space="preserve">
    <t t-inherit="point_of_sale.Navbar" t-inherit-mode="extension">
        <xpath expr="//Input" position="attributes">
            <attribute name="t-if">!this.isBasicUser &amp;&amp; pos.showSearchButton()</attribute>
        </xpath>

          <xpath expr="//div[contains(@class, 'pos-burger-menu-items')]" position="inside">
            <DropdownItem t-if="true" onSelected="() => this.pos.closeSession()">
                Close Register
            </DropdownItem>
        </xpath>
    </t>
</templates>

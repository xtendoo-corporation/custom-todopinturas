<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="todopintura_pos_custom.ControlButtons" t-inherit="point_of_sale.ControlButtons"
       t-inherit-mode="extension">
        <xpath expr="//div[hasclass('control-buttons-modal')]" position="inside">
            <button class="btn btn-secondary btn-lg py-5" t-on-click="() => this.clickNuevoBoton()">
                <i class="fa fa-truck me-1" role="img" aria-label="Crear Pedido y Albarán"
                   title="Crear Pedido y Albarán"/>
                Crear Pedido y Albarán
            </button>
            <button class="btn btn-secondary btn-lg py-5" t-on-click="() => this.clickNuevoBotonAlmacen()">
                <i class="fa fa-truck me-1" role="img" aria-label="Crear Pedido y Seleccionar Almacén"
                   title="Crear Pedido y Seleccionar Almacén"/>
                            Crear Pedido y Seleccionar Almacén
            </button>
        </xpath>
    </t>
</templates>

<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="point_of_sale.ProductScreen" t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension">
        <xpath expr="//div[contains(@class, 'rightpane')]" position="attributes">
            <!-- Mostramos el panel solo si NO es usuario básico o la restricción está desactivada -->
            <attribute name="t-if">(!ui.isSmall || pos.mobile_pane === 'right') and !this.isBasicUser</attribute>
        </xpath>
    </t>
</templates>

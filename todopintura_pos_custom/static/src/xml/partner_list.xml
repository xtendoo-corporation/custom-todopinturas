<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="todopintura_pos_custom.PartnerList" t-inherit="point_of_sale.PartnerList" t-inherit-mode="extension"
       owl="1">
         <xpath expr="//Input" position="attributes">
            <attribute name="t-on-input">(ev) => this.onQueryInput(ev.target.value)</attribute>
        </xpath>

       <xpath expr="//table" position="replace">
            <!-- Spinner de carga centrado -->
            <div t-if="state.isLoading" class="text-center py-5">
                <i class="fa fa-spinner fa-spin fa-2x"></i>
                <p>Cargando clientes...</p>
            </div>

            <!-- Mensaje cuando no hay resultados -->
            <div t-elif="getPartners().length === 0" class="alert alert-info my-3 text-center">
                No hay clientes que mostrar. Escribe para buscar.
            </div>

            <!-- Tabla original con nuestras optimizaciones -->
            <table t-else="" class="table table-hover">
                <thead t-if="!ui.isSmall">
                    <tr>
                        <th class="py-2">Name</th>
                        <th class="py-2">Address</th>
                        <th class="partner-line-email py-2">Contact</th>
                        <th class="pos-right-align py-2" t-if="isBalanceDisplayed">Balance</th>
                        <th class="py-2"></th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="getPartners().slice(0, state.visibleLimit)" t-as="partner" t-key="partner.id">
                        <PartnerLine
                            close="props.close"
                            partner="partner"
                            isSelected="props.partner?.id === partner.id"
                            isBalanceDisplayed="isBalanceDisplayed"
                            onClickEdit.bind="(p) => this.editPartner(p)"
                            onClickUnselect.bind="() => this.clickPartner()"
                            onClickOrders.bind="(p) => this.goToOrders(p)"
                            onClickPartner.bind="clickPartner"/>
                    </t>
                </tbody>
            </table>
        </xpath>
    </t>
</templates>

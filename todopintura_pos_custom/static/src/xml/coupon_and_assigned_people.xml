<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="todopintura_pos_custom.CouponAndAssignedPeopleDialog" owl="1">
        <Dialog title="'Cliente con personas asignadas'" size="'md'">
            <div class="p-3">
                <p>El cliente <strong t-esc="props.partner.name"></strong> tiene personas asignadas.</p>
                <p>Seleccione una opción:</p>

                <div class="d-flex flex-column gap-2 mt-3">
                    <button
                        t-att-class="state.option === 'coupon' ? 'btn btn-primary' : 'btn btn-outline-primary'"
                        t-on-click="() => this.selectOption('coupon')">
                        Tiene Vale
                    </button>
                    <button
                        t-att-class="state.option === 'assigned_people' ? 'btn btn-primary' : 'btn btn-outline-primary'"
                        t-on-click="() => this.selectOption('assigned_people')">
                        Personas Asignadas
                    </button>
                </div>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-secondary" t-on-click="onClickCancel">Cancelar</button>
                <button class="btn btn-primary" t-on-click="onClickConfirm">Confirmar</button>
            </t>
        </Dialog>
    </t>
</templates>

<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="todopintura_pos_custom.CouponAndAssignedPeopleDialog" owl="1">
        <Dialog title="'Información de personas asignadas'" size="'md'">
            <div class="p-3">
                <p>El cliente <strong t-esc="props.partner.name"></strong> tiene personas asignadas:</p>

                <div class="mt-3 p-3 border rounded bg-light">
                    <p t-esc="assignedPeopleText" class="mb-0"></p>
                </div>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-secondary" t-on-click="onClickCancel">Cancelar</button>
                <button class="btn btn-primary" t-on-click="onClickConfirm">Confirmar</button>
            </t>
        </Dialog>
    </t>
</templates>

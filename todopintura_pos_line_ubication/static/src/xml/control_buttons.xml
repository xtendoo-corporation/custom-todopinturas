<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="todopintura_pos_custom.ControlButtonsUbication" t-inherit="point_of_sale.ControlButtons"
       t-inherit-mode="extension">
        <xpath expr="//div[hasclass('control-buttons-modal')]" position="inside">
            <button class="btn btn-secondary btn-lg py-5" t-on-click="changeUbicationLine">
                <i class="fa fa-map-marker me-1" role="img" aria-label="Cambiar Ubicación de Línea"
                   title="Cambiar Ubicación de Línea"/>
                Cambiar Ubicación de Línea
            </button>
        </xpath>
    </t>
</templates>

<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Inherit web_responsive.AppMenuItem to display the badge on the Xtendoo Barcode app icon -->
    <t t-inherit="web_responsive.AppMenuItem" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('o_app')]" position="inside">
            <t t-if="props.app.xmlid === 'xtendoo_stock_barcode.menu_xtendoo_stock_barcode_root' and state.tpPendingCount &gt; 0">
                <span class="position-absolute badge rounded-pill bg-danger" style="top: -5px; right: -5px; font-size: 0.75rem; min-width: 1.25rem; z-index: 10;">
                    <t t-esc="state.tpPendingCount"/>
                </span>
            </t>
        </xpath>
    </t>

    <!-- Inherit Barcode MainMenu to display the badge on the 'Solicitudes central' button -->
    <t t-inherit="xtendoo_stock_barcode.MainMenu" t-inherit-mode="extension" owl="1">
        <xpath expr="//button[@t-on-click='openCentralRequestsAction']" position="attributes">
            <attribute name="class" add="position-relative" separator=" "/>
        </xpath>
        <xpath expr="//button[@t-on-click='openCentralRequestsAction']" position="inside">
            <span t-if="state.tpPendingRequestsCount &gt; 0" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.75rem; z-index: 10;">
                <t t-esc="state.tpPendingRequestsCount"/>
            </span>
        </xpath>
    </t>
</templates>

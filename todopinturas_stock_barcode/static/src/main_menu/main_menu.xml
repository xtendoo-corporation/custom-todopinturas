<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="todopinturas_stock_barcode.MainMenu"
       t-inherit="xtendoo_stock_barcode.MainMenu"
       t-inherit-mode="extension">
        <xpath expr="//div[hasclass('d-flex') and hasclass('flex-wrap') and hasclass('gap-2')]" position="replace">
            <div/>
        </xpath>

        <xpath expr="//h1[hasclass('h3')]" position="replace">
            <h1 class="h3 mb-2">Solicitudes Central</h1>
        </xpath>

        <xpath expr="//p[hasclass('text-muted') and hasclass('mb-0')]" position="replace">
            <p class="text-muted mb-0">
                Acceso directo a las solicitudes del almacén central.
            </p>
        </xpath>

        <xpath expr="//div[@role='alert' and hasclass('alert') and hasclass('alert-info')]" position="replace">
            <div/>
        </xpath>

        <xpath expr="//div[hasclass('row') and hasclass('g-3') and hasclass('mb-4')]" position="replace">
            <div class="row g-3 mb-4">
                <div class="col-12">
                    <button type="button" class="btn btn-primary w-100 py-3" t-on-click="openCentralRequestsAction">
                        Solicitudes Central
                    </button>
                </div>
            </div>
        </xpath>

        <xpath expr="//div[hasclass('border') and hasclass('rounded') and hasclass('bg-light')]" position="replace">
            <div/>
        </xpath>
    </t>
</templates>


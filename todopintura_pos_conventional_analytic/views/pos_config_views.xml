<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_config_view_form_analytic" model="ir.ui.view">
        <field name="name">pos.config.form.analytic</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='configuration']/div[hasclass('o_settings_container')]" position="inside">
                <setting string="Cuenta analítica"
                         help="Se aplica automáticamente a los apuntes de venta y coste generados al cerrar la sesión de esta caja.">
                    <field name="analytic_account_id"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_payment_mode_form_xtd_effects" model="ir.ui.view">
        <field name="name">account.payment.mode.form.xtd.effects</field>
        <field name="model">account.payment.mode</field>
        <field name="inherit_id" ref="account_payment_mode.account_payment_mode_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='refund_payment_mode_id']" position="after">
                <field name="xtd_manage_effects_discount"/>
                <field
                    name="xtd_pending_effects_account_id"
                    invisible="not xtd_manage_effects_discount"
                    required="xtd_manage_effects_discount"
                />
                <field
                    name="xtd_discounted_effects_account_id"
                    invisible="not xtd_manage_effects_discount"
                    required="xtd_manage_effects_discount"
                />
            </xpath>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_xtd_effects" model="ir.ui.view">
        <field name="name">account.move.form.xtd.effects</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_open_xtd_effect_payment"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-bank"
                    invisible="not xtd_effect_payment_id"
                >
                    <div class="o_form_field o_stat_info">
                        <span class="o_stat_text">Efecto (Giro)</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>

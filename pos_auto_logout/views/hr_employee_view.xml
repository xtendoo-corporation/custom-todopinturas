<odoo>
    <data>
        <record id="view_employee_form_inherit_access_code" model="ir.ui.view">
            <field name="name">hr.employee.form.inherit.access.code</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='pin']" position="before">
                    <field name="access_code" string="Access Code"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>

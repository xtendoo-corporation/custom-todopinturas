<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Regla para stock.picking: SOLO si el tipo de picking es del almacén del usuario -->
        <record id="stock_picking_user_warehouse_rule" model="ir.rule">
            <field name="name">Stock Picking: solo almacén asignado</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="domain_force">[('picking_type_id.warehouse_id', '=', user.property_warehouse_id.id)]</field>
            <field name="groups" eval="[(4, ref('todopintura_inventory_permisions.group_inventory_tienda_2'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
        <!-- Regla para stock.quant: SOLO si la ubicación y el almacén son del usuario -->
        <record id="stock_quant_user_warehouse_rule" model="ir.rule">
            <field name="name">Stock Quant: solo almacén asignado</field>
            <field name="model_id" ref="stock.model_stock_quant"/>
            <field name="domain_force">[
                '&amp;',
                ('location_id', 'child_of', user.property_warehouse_id.lot_stock_id.id),
                ('warehouse_id', '=', user.property_warehouse_id.id)
            ]</field>
            <field name="groups" eval="[(4, ref('todopintura_inventory_permisions.group_inventory_tienda_2'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
        <!-- Regla para stock.location: SOLO si la ubicación es hija de la principal del almacén del usuario o tiene el warehouse_id igual al almacén asignado -->
        <record id="stock_location_user_warehouse_rule" model="ir.rule">
            <field name="name">Stock Location: solo almacén asignado</field>
            <field name="model_id" ref="stock.model_stock_location"/>
            <field name="domain_force">['|', ('id', 'child_of', user.property_warehouse_id.lot_stock_id.id), ('warehouse_id', '=', user.property_warehouse_id.id)]</field>
            <field name="groups" eval="[(4, ref('todopintura_inventory_permisions.group_inventory_tienda_2'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
        <!-- Regla para stock.move: SOLO si el tipo de picking es del almacén del usuario -->
        <record id="stock_move_user_warehouse_rule" model="ir.rule">
            <field name="name">Stock Move: solo almacén asignado</field>
            <field name="model_id" ref="stock.model_stock_move"/>
            <field name="domain_force">[('picking_type_id.warehouse_id', '=', user.property_warehouse_id.id)]</field>
            <field name="groups" eval="[(4, ref('todopintura_inventory_permisions.group_inventory_tienda_2'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
        <!-- Regla para stock.move.line: SOLO si ambas ubicaciones son del almacén del usuario -->
        <record id="stock_move_line_user_warehouse_rule" model="ir.rule">
            <field name="name">Stock Move Line: solo almacén asignado</field>
            <field name="model_id" ref="stock.model_stock_move_line"/>
            <field name="domain_force">[
                '&amp;',
                ('location_id', 'child_of', user.property_warehouse_id.lot_stock_id.id),
                ('location_dest_id', 'child_of', user.property_warehouse_id.lot_stock_id.id)
            ]</field>
            <field name="groups" eval="[(4, ref('todopintura_inventory_permisions.group_inventory_tienda_2'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
        <!-- Regla para stock.warehouse: SOLO el almacén asignado -->
        <record id="stock_warehouse_user_warehouse_rule" model="ir.rule">
            <field name="name">Stock Warehouse: solo almacén asignado</field>
            <field name="model_id" ref="stock.model_stock_warehouse"/>
            <field name="domain_force">[('id', '=', user.property_warehouse_id.id)]</field>
            <field name="groups" eval="[(4, ref('todopintura_inventory_permisions.group_inventory_tienda_2'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
        <!-- Regla para stock.warehouse.orderpoint (reposiciones): SOLO el almacén asignado -->
        <record id="stock_orderpoint_user_warehouse_rule" model="ir.rule">
            <field name="name">Stock Orderpoint: solo almacén asignado</field>
            <field name="model_id" ref="stock.model_stock_warehouse_orderpoint"/>
            <field name="domain_force">[('warehouse_id', '=', user.property_warehouse_id.id)]</field>
            <field name="groups" eval="[(4, ref('todopintura_inventory_permisions.group_inventory_tienda_2'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
        <!-- Regla para stock.picking.type: SOLO tipos de operación del almacén asignado -->
        <record id="stock_picking_type_user_warehouse_rule" model="ir.rule">
            <field name="name">Stock Picking Type: solo almacén asignado</field>
            <field name="model_id" ref="stock.model_stock_picking_type"/>
            <field name="domain_force">[('warehouse_id', '=', user.property_warehouse_id.id)]</field>
            <field name="groups" eval="[(4, ref('todopintura_inventory_permisions.group_inventory_tienda_2'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>

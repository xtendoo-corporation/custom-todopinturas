<odoo>
    <record id="inherit_product_pricelist_supplier_item_form_view" model="ir.ui.view">
        <field name="name">inherit.product.pricelist.item.form</field>
        <field name="model">product.pricelist.item</field>
        <field name="inherit_id" ref="product.product_pricelist_item_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='price_max_margin']/.." position="after">
                <field name="filter_supplier_id"/>
            </xpath>
        </field>
    </record>
</odoo>

<t t-name="todopintura_pos_line_location.LocationSelectionDialog" owl="1">
    <Dialog title="props.title" size="'md'" >
        <div class="modal-body p-3">
            <p t-if="props.bodyMessage" class="text-prewrap" t-out="props.bodyMessage"/>
            <div class="location-selection-container">
                <t t-if="!state.hasLocations">
                    <div class="alert alert-info">
                        <p>No hay líneas con ubicación asignada. Si confirma, se creará una venta estándar con un solo albarán.</p>
                    </div>
                </t>
                <t t-elif="props.locations &amp;&amp; props.locations.length">
                    <div class="py-2">
                        <!-- Primero mostramos los productos -->
                        <div class="products-list mb-4">
                            <h5>Productos en el pedido:</h5>
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Producto</th>
                                        <th>Cantidad</th>
                                        <th>Ubicación</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="props.orderProducts" t-as="product" t-key="product.id">
                                        <tr>
                                            <td>
                                                <span t-esc="product.name"/>
                                            </td>
                                            <td>
                                                <span t-esc="product.quantity"/>
                                            </td>
                                            <td>
                                                <select class="form-select form-select-sm"
                                                        t-on-change="(ev) => this.handleProductLocationChange(product.id, ev)">
                                                    <option value="">Seleccionar ubicación</option>
                                                    <t t-foreach="props.locations" t-as="location" t-key="location.id">
                                                        <option t-att-value="location.id"
                                                                t-att-selected="state.productsByLocation[product.id] === location.id">
                                                            <t t-esc="location.complete_name || location.name"/>
                                                            <t t-if="props.inventoryData &amp;&amp; props.inventoryData[location.id]">
                                                                <t t-set="productStock"
                                                                   t-value="props.inventoryData[location.id].find(p => p.product_id === product.id) || {quantity: 0}"/>
                                                                <t t-esc="' [Stock: ' + (productStock.quantity || 0) + ']'"/>
                                                            </t>
                                                        </option>
                                                    </t>
                                                </select>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </t>
                <div t-else="" class="alert alert-warning">
                    No se encontraron ubicaciones disponibles
                </div>
            </div>
        </div>
        <t t-set-slot="footer">
            <button class="btn btn-primary"
                    t-on-click="onClickConfirm"
                    t-att-disabled="state.hasLocations &amp;&amp; state.selectedLocations.length === 0">
                <t t-if="state.hasLocations">Confirmar</t>
                <t t-else="">Crear venta estándar</t>
            </button>
            <button class="btn btn-secondary" t-on-click="onClickCancel">
                Cancelar
            </button>
        </t>
    </Dialog>
</t>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_pos_credit_deposit" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.pos.credit.deposit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_pos_credit_orders"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-credit-card"
                        invisible="not pos_order_credit_count">
                    <field name="pos_order_credit_count" widget="statinfo" string="Credito TPV"/>
                </button>
                <button name="action_view_pos_deposit_orders"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-university"
                        invisible="not pos_order_deposit_count">
                    <field name="pos_order_deposit_count" widget="statinfo" string="Deposito TPV"/>
                </button>
            </div>
        </field>
    </record>
</odoo>

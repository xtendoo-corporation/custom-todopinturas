<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Vista unificada: Heredamos del último eslabón (deposit) para ocultar todo lo anterior y añadir lo nuevo -->
    <record id="view_pos_pos_form_payment_selection_main" model="ir.ui.view">
        <field name="name">view_pos_pos_form_payment_selection</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="todopintura_pos_conventional_deposit.view_pos_pos_form_payment_wizard_deposit_button"/>
        <field name="priority">9999</field>
        <field name="arch" type="xml">
            <!-- 1. Ocultar botones y widgets originales del abuelo (pos_conventional_payment_wizard) -->
            <xpath expr="//button[@name='action_open_payment_popup']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//widget[@name='pos_actionpad_fast_payment_buttons']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- 2. Ocultar botón del padre (todopintura_pos_conventional_deposit) -->
            <xpath expr="//button[@name='action_pay_deposit']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- 3. Añadir nuestro botón de Pago personalizado -->
            <xpath expr="//button[@name='action_open_payment_popup']" position="after">
                <button name="action_open_payment_selection_wizard"
                        string="Pago"
                        type="object"
                        class="btn-primary"
                        invisible="state != 'draft'"/>
            </xpath>
        </field>
    </record>

    <!-- Eliminamos la segunda vista redundante ya que la lógica está unificada arriba -->
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_payment_selection_list_wizard" model="ir.ui.view">
        <field name="name">pos.payment.selection.list.wizard</field>
        <field name="model">pos.payment</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" class="o_list_table_compact">
                <field name="payment_method_id" string="Método"/>
                <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}" string="Cantidad"/>
                <field name="currency_id" column_invisible="True"/>
                <button name="action_delete_payment_from_wizard" icon="fa-trash" type="object" class="text-danger" title="Eliminar"/>
            </list>
        </field>
    </record>

    <record id="view_pos_deposit_payment_wizard_payment_line_list_wizard" model="ir.ui.view">
        <field name="name">pos.deposit.payment.wizard.payment.line.list.wizard</field>
        <field name="model">pos.deposit.payment.wizard.payment.line</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" class="o_list_table_compact">
                <field name="payment_method_id" string="Método"/>
                <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}" string="Cantidad"/>
                <field name="currency_id" column_invisible="True"/>
                <button name="action_delete_payment_from_wizard" icon="fa-trash" type="object" class="text-danger" title="Eliminar"/>
            </list>
        </field>
    </record>

    <record id="view_pos_payment_selection_wizard_form" model="ir.ui.view">
        <field name="name">pos.payment.selection.wizard.form</field>
        <field name="model">pos.payment.selection.wizard</field>
        <field name="arch" type="xml">
            <form string="Seleccione tipo de pago" class="o_todopintura_payment_wizard">
                <field name="order_id" invisible="1"/>
                <field name="deposit_wizard_id" invisible="1"/>
                <field name="state" invisible="1"/>
                <field name="document_type" invisible="1"/>
                <field name="partner_id" invisible="1"/>
                <field name="payment_method_ids" invisible="1"/>
                <field name="has_cash_method" invisible="1"/>
                <field name="has_card_method" invisible="1"/>
                <field name="show_deposit_button" invisible="1"/>
                <field name="partner_deposit_enabled" invisible="1"/>
                <field name="partner_deposit_available" invisible="1"/>
                <field name="partner_deposit_warning_message" invisible="1"/>
                <field name="partner_credit_available" invisible="1"/>
                <field name="partner_credit_available_at_open" invisible="1"/>
                <field name="partner_credit_limit_exceeded" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <field name="order_processed" invisible="1"/>

                <!-- Avisos: banner a todo el ancho bajo el título del diálogo -->
                <div class="o_todopintura_wizard_alerts" invisible="order_processed">
                    <div invisible="partner_id" class="alert alert-warning d-flex align-items-center gap-3" role="alert">
                        <span class="fa fa-exclamation-triangle" title="Aviso"/>
                        <div><strong>Aviso:</strong> Para Albarán o Depósito es necesario seleccionar un cliente.</div>
                    </div>
                    <div invisible="not partner_id or partner_deposit_enabled or operation_type != 'deposit'" class="alert alert-warning d-flex align-items-center gap-3" role="alert">
                        <span class="fa fa-exclamation-triangle" title="Aviso"/>
                        <div><strong>Aviso:</strong> El cliente no tiene depósitos habilitados.</div>
                    </div>
                    <div invisible="not partner_id or not partner_deposit_enabled or partner_deposit_available or operation_type != 'deposit'" class="alert alert-warning d-flex align-items-center gap-3" role="alert">
                        <span class="fa fa-exclamation-triangle" title="Aviso"/>
                        <field name="partner_deposit_warning_message"/>
                    </div>
                    <div invisible="not partner_id or partner_credit_available_at_open or operation_type != 'delivery'" class="alert alert-warning d-flex align-items-center gap-3" role="alert">
                        <span class="fa fa-exclamation-triangle" title="Aviso"/>
                        <div><strong>Aviso:</strong> El cliente no tiene crédito habilitado en esta caja.</div>
                    </div>
                    <div invisible="not partner_id or not partner_credit_limit_exceeded or operation_type != 'delivery'" class="alert alert-danger d-flex align-items-start gap-3" role="alert">
                        <span class="fa fa-exclamation-triangle mt-1" title="Atención"/>
                        <div class="flex-grow-1">
                            <strong>Atención: Límite de crédito superado</strong>
                            <p class="mb-2 text-muted">El cliente ha excedido su límite de riesgo y no se permite confirmar la venta.</p>
                            <div class="d-flex flex-wrap gap-4 small">
                                <div>Límite de riesgo: <strong><field name="partner_credit_limit"/></strong></div>
                                <div>Total tras pedido: <strong class="text-danger"><field name="partner_total_due_after"/></strong></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="container-fluid">
                    <div class="row">
                        <!-- Izquierda: Selecciones -->
                        <div class="col-md-5 border-end">
                            <group string="¿Qué desea hacer?">
                                <field name="operation_type" widget="radio" nolabel="1" colspan="2"
                                       invisible="deposit_wizard_id"/>
                                <field name="operation_type_deposit" widget="radio" nolabel="1" colspan="2"
                                       invisible="not deposit_wizard_id"/>
                            </group>

                            <group string="Método de Pago" invisible="operation_type != 'ticket' and operation_type != 'invoice'">
                                <field name="payment_type" widget="radio" nolabel="1" colspan="2"/>
                            </group>

                        </div>

                        <!-- Derecha: Detalles del Pago -->
                        <div class="col-md-7 ps-4">
                            <div invisible="operation_type != 'ticket' and operation_type != 'invoice'">
                                <div class="o_horizontal_separator mt-4 mb-3 text-uppercase fw-bolder small">RESUMEN DE PAGO</div>
                                <div class="w-100 px-2 o_todopintura_summary_card">
                                    <!-- Deliberately a plain <div>, NOT inside <group>: Odoo's <group> wraps
                                         every one of its cells in its own CSS Grid item machinery, which was
                                         silently forcing everything nested inside (rows, labels, values) to
                                         stack as blocks no matter what layout technique (flex/grid/table/
                                         absolute/float) was tried on them. -->
                                    <div class="o_todopintura_amount_row" invisible="amount_paid == 0 and payment_type != 'combined'">
                                        <span class="o_todopintura_amount_label">Total Pedido:</span>
                                        <field name="amount_total" nolabel="1" widget="monetary" options="{'currency_field': 'currency_id'}"
                                               readonly="1" class="o_todopintura_amount_value"/>
                                    </div>
                                    <div class="o_todopintura_amount_row" invisible="amount_paid == 0 and payment_type != 'combined'">
                                        <span class="o_todopintura_amount_label text-success">Pagado:</span>
                                        <field name="amount_paid" nolabel="1" widget="monetary" options="{'currency_field': 'currency_id'}"
                                               readonly="1" class="o_todopintura_amount_value text-success"/>
                                    </div>
                                    <!-- Same row style as Total Pedido / Pagado whenever those are shown -->
                                    <div class="o_todopintura_amount_row o_todopintura_total_due_row" invisible="amount_paid == 0 and payment_type != 'combined'">
                                        <span class="o_todopintura_amount_label">Total a Pagar:</span>
                                        <field name="amount_due" nolabel="1" widget="monetary" options="{'currency_field': 'currency_id'}"
                                               readonly="1" class="o_todopintura_amount_value"/>
                                    </div>
                                    <div class="o_todopintura_amount_block o_todopintura_total_due" invisible="amount_paid != 0 or payment_type == 'combined'">
                                        <div class="o_todopintura_amount_label">Total a Pagar:</div>
                                        <div class="input-group o_todopintura_cash_input_group">
                                            <span class="input-group-text">€</span>
                                            <field name="amount_due" nolabel="1" widget="monetary"
                                                   options="{'currency_field': 'currency_id', 'no_symbol': True}"
                                                   readonly="1" class="form-control o_todopintura_amount_input"/>
                                        </div>
                                    </div>
                                    <div class="o_todopintura_amount_block" invisible="payment_type != 'cash'">
                                        <div class="o_todopintura_amount_label">Importe Entregado:</div>
                                        <div class="input-group o_todopintura_cash_input_group">
                                            <span class="input-group-text">€</span>
                                            <field name="amount_tendered" nolabel="1" widget="monetary"
                                                   options="{'currency_field': 'currency_id', 'no_symbol': True}"
                                                   class="form-control o_todopintura_amount_input"/>
                                        </div>
                                    </div>
                                    <div class="o_todopintura_amount_block" invisible="payment_type != 'cash' or amount_change == 0">
                                        <div class="o_todopintura_amount_label">Cambio / Restante:</div>
                                        <div class="input-group o_todopintura_cash_input_group">
                                            <span class="input-group-text">€</span>
                                            <field name="amount_change" nolabel="1" invisible="amount_change &lt;= 0" readonly="1" widget="monetary"
                                                   options="{'currency_field': 'currency_id', 'no_symbol': True}"
                                                   class="form-control o_todopintura_amount_input text-danger"/>
                                            <field name="amount_change_abs" nolabel="1" invisible="amount_change > 0" readonly="1" widget="monetary"
                                                   options="{'currency_field': 'currency_id', 'no_symbol': True}"
                                                   class="form-control o_todopintura_amount_input text-success"/>
                                        </div>
                                    </div>

                                    <div invisible="payment_type != 'combined'" class="o_todopintura_combined">
                                        <div class="o_todopintura_amount_block">
                                            <div class="o_todopintura_amount_label">Forma de Pago:</div>
                                            <field name="selected_payment_method_id" nolabel="1" widget="selection"
                                                   domain="[('id', 'in', payment_method_ids)]"
                                                   class="w-100 o_todopintura_method_select"/>
                                        </div>
                                        <div class="o_todopintura_amount_block">
                                            <div class="o_todopintura_amount_label">Importe:</div>
                                            <div class="d-flex gap-2">
                                                <div class="input-group o_todopintura_cash_input_group flex-grow-1">
                                                    <span class="input-group-text">€</span>
                                                    <field name="payment_amount" nolabel="1" widget="monetary"
                                                           options="{'currency_field': 'currency_id', 'no_symbol': True}"
                                                           class="form-control o_todopintura_amount_input"/>
                                                </div>
                                                <button name="action_add_payment" type="object" title="Añadir pago"
                                                        class="btn btn-primary o_todopintura_add_payment">
                                                    <i class="fa fa-plus"/>
                                                </button>
                                            </div>
                                        </div>
                                        <div class="o_payment_list mt-3" style="max-height: 200px; overflow-y: auto;">
                                            <field name="payment_line_ids" nolabel="1" invisible="deposit_wizard_id"
                                                   context="{'tree_view_ref': 'todopintura_extend_pos_conventional_payment.view_pos_payment_selection_list_wizard'}"/>
                                            <field name="deposit_payment_line_ids" nolabel="1" invisible="not deposit_wizard_id"
                                                   context="{'tree_view_ref': 'todopintura_extend_pos_conventional_payment.view_pos_deposit_payment_wizard_payment_line_list_wizard'}"/>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div invisible="operation_type != 'delivery'" class="text-center py-5">
                                <i class="fa fa-truck fa-5x text-muted mb-3" title="Albarán"/>
                                <h4>Confirma el pedido como albarán entregado (Crédito).</h4>
                                <p class="text-muted">Se generará la salida de stock y se registrará la deuda en la cuenta del cliente.</p>
                            </div>

                            <div invisible="operation_type != 'deposit'" class="text-center py-5">
                                <i class="fa fa-university fa-5x text-muted mb-3" title="Depósito"/>
                                <h4>Registra un depósito a cuenta del cliente.</h4>
                                <p class="text-muted">El importe se descontará de su saldo disponible.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <footer>
                    <button name="action_confirm" string="Confirmar" type="object" class="btn-primary"
                            invisible="(not deposit_wizard_id and operation_type == 'delivery' and (not partner_id or not partner_credit_available_at_open or partner_credit_limit_exceeded)) or (operation_type == 'deposit' and (not partner_id or not partner_deposit_enabled or not partner_deposit_available)) or (deposit_wizard_id and operation_type != 'ticket' and operation_type != 'invoice')"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pos_payment_selection_wizard" model="ir.actions.act_window">
        <field name="name">Selección de Pago</field>
        <field name="res_model">pos.payment.selection.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>

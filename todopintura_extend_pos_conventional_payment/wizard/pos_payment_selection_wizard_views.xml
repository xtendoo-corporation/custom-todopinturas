<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_payment_selection_wizard_form" model="ir.ui.view">
        <field name="name">pos.payment.selection.wizard.form</field>
        <field name="model">pos.payment.selection.wizard</field>
        <field name="arch" type="xml">
            <form string="Seleccione tipo de pago">
                <field name="order_id" invisible="1"/>
                <div class="text-center mb-4">
                    <h3>¿Qué desea hacer?</h3>
                </div>
                <div class="d-flex flex-column align-items-center gap-2">
                    <button name="action_ticket" string="Ticket" type="object" class="btn-primary btn-lg w-50"/>
                    <button name="action_factura" string="Factura" type="object" class="btn-primary btn-lg w-50"/>
                    <button name="action_albaran" string="Albarán" type="object" class="btn-primary btn-lg w-50"/>
                    <button name="action_deposito" string="Depósito" type="object" class="btn-primary btn-lg w-50"/>
                    <button name="action_credito" string="Crédito" type="object" class="btn-primary btn-lg w-50"/>
                </div>
                <footer>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pos_payment_selection_wizard" model="ir.actions.act_window">
        <field name="name">Selección de Pago</field>
        <field name="res_model">pos.payment.selection.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>

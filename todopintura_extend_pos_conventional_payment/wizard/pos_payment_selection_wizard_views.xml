<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_payment_selection_wizard_form" model="ir.ui.view">
        <field name="name">pos.payment.selection.wizard.form</field>
        <field name="model">pos.payment.selection.wizard</field>
        <field name="arch" type="xml">
            <form string="Seleccione tipo de pago">
                <field name="order_id" invisible="1"/>
                <field name="state" invisible="1"/>
                <field name="document_type" invisible="1"/>
                <field name="partner_id" invisible="1"/>
                <field name="payment_method_ids" invisible="1"/>
                <field name="has_cash_method" invisible="1"/>
                <field name="has_card_method" invisible="1"/>
                <field name="show_deposit_button" invisible="1"/>
                <field name="partner_credit_available" invisible="1"/>

                <!-- PASO 1: Selección de Documento -->
                <div invisible="state != 'doc_selection'">
                    <div class="text-center mb-4">
                        <h3>¿Qué desea hacer?</h3>
                        <div invisible="partner_id" class="alert alert-warning py-1" role="alert">
                            <strong>Aviso:</strong> Para Albarán, Depósito o Crédito es necesario seleccionar un cliente.
                        </div>
                    </div>

                    <div class="d-flex flex-column align-items-center gap-2">
                        <div class="d-flex flex-row gap-2 w-75">
                             <button name="action_ticket" string="Ticket (Simp.)" type="object" class="btn-primary btn-lg flex-grow-1"/>
                             <button name="action_factura" string="Factura" type="object" class="btn-primary btn-lg flex-grow-1"/>
                        </div>

                        <button name="action_albaran" string="Confirmar Albarán" type="object" class="btn-primary btn-lg w-75"
                                invisible="not partner_id"/>

                        <button name="action_deposito" string="Hacer Depósito" type="object" class="btn-primary btn-lg w-75"
                                invisible="not partner_id or not show_deposit_button"/>
                    </div>
                </div>

                <!-- PASO 2: Selección de Pago (Después de elegir Ticket o Factura) -->
                <div invisible="state != 'payment_selection'">
                    <div class="text-center mb-4">
                        <h3>Seleccione Método de Pago</h3>
                        <p class="text-muted">Documento:
                            <span invisible="document_type != 'ticket'">Ticket (Simplificada)</span>
                            <span invisible="document_type != 'factura_simplified'">Factura Simplificada</span>
                            <span invisible="document_type != 'factura_a4'">Factura A4</span>
                        </p>
                    </div>

                    <div class="d-flex flex-column align-items-center gap-2">
                        <div class="d-flex flex-row gap-2 w-75">
                             <button name="action_pago_efectivo" string="Efectivo" type="object" class="btn-primary btn-lg flex-grow-1"
                                     invisible="not has_cash_method"/>
                             <button name="action_pago_tarjeta" string="Tarjeta" type="object" class="btn-primary btn-lg flex-grow-1"
                                     invisible="not has_card_method"/>
                        </div>

                        <button name="action_pago_combinado" string="Pago combinado" type="object" class="btn-primary btn-lg w-75"/>

                        <button name="action_cancel_payment_step" string="Volver atrás" type="object" class="btn-link mt-2"/>
                    </div>
                </div>

                <footer>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pos_payment_selection_wizard" model="ir.actions.act_window">
        <field name="name">Selección de Pago</field>
        <field name="res_model">pos.payment.selection.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_deposit_payment_wizard_form" model="ir.ui.view">
        <field name="name">pos.deposit.payment.wizard.form</field>
        <field name="model">pos.deposit.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Cobrar depósitos">
                <field name="session_id" invisible="1"/>
                <field name="config_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <field name="available_payment_method_ids" invisible="1"/>
                <field name="eligible_partner_ids" invisible="1"/>
                <field name="selected_order_ids" invisible="1"/>
                <field name="has_cash_payment" invisible="1"/>
                <field name="is_payment_ready" invisible="1"/>

                <field name="step" widget="statusbar" statusbar_visible="orders,payment" readonly="1"/>

                <group string="Datos de la operación" invisible="step != 'orders'" col="4">
                    <field name="partner_id" options="{'no_create': True, 'no_open': True}"/>
                    <field name="config_id" readonly="1" force_save="1"/>
                    <field name="amount_total"
                           readonly="1"
                           widget="monetary"
                           options="{'currency_field': 'currency_id'}"/>
                </group>

                <separator string="Pedidos en depósito" invisible="step != 'orders'"/>
                <div class="d-flex gap-2 mb-2" invisible="step != 'orders' or not deposit_order_line_ids">
                    <button name="action_select_all_orders"
                            type="object"
                            string="Seleccionar todos"
                            class="btn-secondary"/>
                    <button name="action_clear_selected_orders"
                            type="object"
                            string="Limpiar selección"
                            class="btn-secondary"/>
                </div>
                <field name="deposit_order_line_ids" nolabel="1" invisible="step != 'orders'">
                    <list editable="bottom" create="0" delete="0">
                        <field name="selected" widget="boolean_toggle"/>
                        <field name="display_reference"/>
                        <field name="date_order"/>
                        <field name="amount_total" sum="Total"/>
                        <field name="picking_count"/>
                    </list>
                </field>

                <group string="Datos del cobro" invisible="step != 'payment'" col="4">
                    <field name="partner_id" readonly="1" options="{'no_create': True, 'no_open': True}"/>
                    <field name="config_id" readonly="1" force_save="1"/>
                    <field name="amount_total"
                           readonly="1"
                           widget="monetary"
                           options="{'currency_field': 'currency_id'}"/>
                    <field name="amount_paid_total"
                           readonly="1"
                           widget="monetary"
                           options="{'currency_field': 'currency_id'}"/>
                    <field name="amount_due"
                           readonly="1"
                           widget="monetary"
                           options="{'currency_field': 'currency_id'}"/>
                    <field name="amount_change"
                           readonly="1"
                           widget="monetary"
                           options="{'currency_field': 'currency_id'}"
                           invisible="amount_change &lt;= 0.0"/>
                </group>

                <separator string="Formas de pago" invisible="step != 'payment'"/>
                <field name="payment_line_ids" nolabel="1" invisible="step != 'payment'">
                    <list editable="bottom">
                        <field name="payment_method_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="amount" sum="Total"/>
                    </list>
                </field>
                <footer>
                    <button name="action_go_to_payment_step"
                            type="object"
                            string="Continuar al cobro"
                            class="btn-primary"
                            invisible="step != 'orders' or not partner_id or not selected_order_count"/>
                    <button name="action_back_to_order_step"
                            type="object"
                            string="Volver a pedidos"
                            class="btn-secondary"
                            invisible="step != 'payment'"/>
                    <button name="action_confirm"
                            type="object"
                            string="Cobrar y abrir factura"
                            class="btn-primary"
                            invisible="step != 'payment' or not partner_id or amount_total &lt;= 0.0 or not is_payment_ready"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>


<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_pos_conventional_credit_deposit" model="ir.ui.view">
        <field name="name">res.partner.form.pos.conventional.credit.deposit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="todopintura_extend_pos_conventional.view_partner_form_pos_conventional_credit"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='pos_conventional_credit']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_partner_form_pos_conventional_credit_deposit_main" model="ir.ui.view">
        <field name="name">res.partner.form.pos.conventional.credit.deposit.main</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='point_of_sale']" position="inside">
                <field name="pos_credit_sale_enabled"/>
                <field name="pos_deposit_sale_enabled"/>
                <field name="use_partner_credit_limit"
                       invisible="not pos_credit_sale_enabled"/>
                <field name="credit_limit"
                       invisible="not pos_credit_sale_enabled or not use_partner_credit_limit"
                       required="pos_credit_sale_enabled and use_partner_credit_limit"/>
                <field name="pos_credit_location_ids"
                       string="Tiendas permitidas para depósito"
                       widget="many2many_tags"
                       invisible="not pos_deposit_sale_enabled"
                       required="pos_deposit_sale_enabled"
                       options="{'no_create': True}"/>
                <field name="pos_requires_voucher"
                       invisible="pos_deposit_sale_enabled and not pos_credit_sale_enabled"/>
                <field name="pos_voucher_reference"
                       invisible="not pos_requires_voucher or (pos_deposit_sale_enabled and not pos_credit_sale_enabled)"/>
            </xpath>
            <xpath expr="//group[@name='point_of_sale']" position="after">
                <group string="Autorizados de recogida" name="pos_pickup_persons">
                    <field name="pos_pickup_person_ids" nolabel="1" context="{'default_partner_id': id}">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="vat"/>
                            <field name="phone"/>
                            <field name="notes"/>
                            <field name="active" optional="hide"/>
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_partner_tree_show_ref" model="ir.ui.view">
        <field name="name">res.partner.list.show.ref</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <field name="complete_name" position="after">
                <field name="ref" string="Referencia" optional="show"/>
            </field>
        </field>
    </record>
</odoo>

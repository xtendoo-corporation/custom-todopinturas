<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_cross_store_picking_info_block">
        <t t-set="pos_order" t-value="o._get_conventional_source_pos_order()"/>
        <t t-if="pos_order and pos_order.origin_warehouse_id">
            <div style="margin-bottom: 3px;">
                <strong>Tienda de venta:</strong><br/>
                <span t-out="pos_order.origin_warehouse_id.display_name"/>
            </div>
            <div t-if="pos_order.has_cross_store_pickup_lines and pos_order.pickup_warehouse_summary" style="margin-bottom: 5px;">
                <strong>Recogida por líneas:</strong><br/>
                <span t-out="pos_order.pickup_warehouse_summary"/>
            </div>
            <div t-if="pos_order.partner_requires_voucher" style="margin-bottom: 5px;">
                <strong>Vale requerido:</strong><br/>
                <span t-out="pos_order.partner_voucher_reference or 'Sí'"/>
            </div>
            <t t-if="pos_order.partner_pickup_persons_display">
                <div style="margin-bottom: 5px;">
                    <strong>Autorizados de recogida:</strong>
                    <div t-out="pos_order.partner_pickup_persons_display.strip()" style="white-space: pre-line;"/>
                </div>
            </t>
        </t>
    </template>

    <template id="report_albaran_80mm_cross_store_info"
              inherit_id="pos_conventional_picking_integration.report_albaran_80mm">
        <xpath expr="//div[@t-if='o.partner_id']" position="after">
            <t t-call="todopintura_extend_pos_conventional.report_cross_store_picking_info_block"/>
        </xpath>
    </template>

    <template id="report_delivery_document_cross_store_info"
              inherit_id="stock.report_delivery_document">
        <xpath expr="//h2/span[@t-out='o.picking_type_id._get_code_report_name()']" position="replace"/>
        <xpath expr="//div[@id='informations']" position="after">
            <t t-call="todopintura_extend_pos_conventional.report_cross_store_picking_info_block"/>
        </xpath>
    </template>

    <template id="stock_report_delivery_has_serial_move_line_forced_valued"
              inherit_id="stock.stock_report_delivery_has_serial_move_line">
        <xpath expr="//td[@name='move_line_lot_quantity']" position="attributes">
            <attribute name="class">text-end</attribute>
        </xpath>
        <xpath expr="//td[@name='move_line_lot_quantity']/span[@t-field='move_line.product_uom_id']" position="replace">
            <span>Uds</span>
        </xpath>
        <xpath expr="//td[@name='move_line_lot_quantity']" position="after">
            <td t-if="o.env.context.get('force_valued_picking') and not ('valued_picking' in o.partner_id._fields and o.partner_id.valued_picking)" class="text-end">
                <span t-esc="move_line.move_id._get_conventional_report_price_unit()"
                      t-options='{"widget": "monetary", "display_currency": env.company.currency_id}'/>
            </td>
            <td t-if="o.env.context.get('force_valued_picking') and not ('valued_picking' in o.partner_id._fields and o.partner_id.valued_picking)" class="text-end">
                <span t-esc="move_line.move_id._get_conventional_report_discounted_price()"
                      t-options='{"widget": "monetary", "display_currency": env.company.currency_id}'/>
            </td>
            <td t-if="o.env.context.get('force_valued_picking') and not ('valued_picking' in o.partner_id._fields and o.partner_id.valued_picking)" class="text-end">
                <span t-esc="move_line.move_id._get_conventional_report_line_total(move_line.quantity)"
                      t-options='{"widget": "monetary", "display_currency": env.company.currency_id}'/>
            </td>
        </xpath>
    </template>

    <template id="stock_report_delivery_aggregated_move_lines_forced_valued"
              inherit_id="stock.stock_report_delivery_aggregated_move_lines">
        <xpath expr="//td[@name='move_line_aggregated_qty_ordered']" position="attributes">
            <attribute name="class">text-end</attribute>
        </xpath>
        <xpath expr="//td[@name='move_line_aggregated_quantity']" position="attributes">
            <attribute name="class">text-end</attribute>
        </xpath>
        <xpath expr="//td[@name='move_line_aggregated_qty_ordered']/span[2]" position="replace">
            <span groups="uom.group_uom">Uds</span>
        </xpath>
        <xpath expr="//td[@name='move_line_aggregated_quantity']/span[2]" position="replace">
            <span groups="uom.group_uom">Uds</span>
        </xpath>
        <xpath expr="//td[@name='move_line_aggregated_quantity']" position="after">
            <td t-if="o.env.context.get('force_valued_picking') and not ('valued_picking' in o.partner_id._fields and o.partner_id.valued_picking)" class="text-end">
                <t t-set="move" t-value="o._get_conventional_report_aggregated_move(aggregated_lines[line])"/>
                <span t-esc="move._get_conventional_report_price_unit()"
                      t-options='{"widget": "monetary", "display_currency": env.company.currency_id}'/>
            </td>
            <td t-if="o.env.context.get('force_valued_picking') and not ('valued_picking' in o.partner_id._fields and o.partner_id.valued_picking)" class="text-end">
                <span t-esc="move._get_conventional_report_discounted_price()"
                      t-options='{"widget": "monetary", "display_currency": env.company.currency_id}'/>
            </td>
            <td t-if="o.env.context.get('force_valued_picking') and not ('valued_picking' in o.partner_id._fields and o.partner_id.valued_picking)" class="text-end">
                <span t-esc="move._get_conventional_report_line_total(aggregated_lines[line].get('qty_done') or aggregated_lines[line].get('quantity'))"
                      t-options='{"widget": "monetary", "display_currency": env.company.currency_id}'/>
            </td>
        </xpath>
    </template>

    <template id="report_delivery_document_forced_valued"
              inherit_id="stock.report_delivery_document">
        <xpath expr="//table[@name='stock_move_table']/tbody/tr/td[2]" position="attributes">
            <attribute name="class">o_td_quantity text-end</attribute>
        </xpath>
        <xpath expr="//table[@name='stock_move_table']/tbody/tr/td[3]" position="attributes">
            <attribute name="class">o_td_quantity text-end</attribute>
        </xpath>
        <xpath expr="//table[@name='stock_move_table']/tbody/tr/td[2]/span[@t-field='move.product_uom']" position="replace">
            <span groups="uom.group_uom">Uds</span>
        </xpath>
        <xpath expr="//table[@name='stock_move_table']/thead/tr/th[@name='th_sm_quantity']" position="after">
            <th t-if="o.env.context.get('force_valued_picking') and not ('valued_picking' in o.partner_id._fields and o.partner_id.valued_picking)" class="text-end"><strong>Precio</strong></th>
            <th t-if="o.env.context.get('force_valued_picking') and not ('valued_picking' in o.partner_id._fields and o.partner_id.valued_picking)" class="text-end"><strong>Neto</strong></th>
            <th t-if="o.env.context.get('force_valued_picking') and not ('valued_picking' in o.partner_id._fields and o.partner_id.valued_picking)" class="text-end"><strong>Importe</strong></th>
        </xpath>
        <xpath expr="//table[@name='stock_move_table']/tbody/tr/td[3]" position="after">
            <td t-if="o.env.context.get('force_valued_picking') and not ('valued_picking' in o.partner_id._fields and o.partner_id.valued_picking)" class="text-end">
                <span t-esc="move._get_conventional_report_price_unit()"
                      t-options='{"widget": "monetary", "display_currency": env.company.currency_id}'/>
            </td>
            <td t-if="o.env.context.get('force_valued_picking') and not ('valued_picking' in o.partner_id._fields and o.partner_id.valued_picking)" class="text-end">
                <span t-esc="move._get_conventional_report_discounted_price()"
                      t-options='{"widget": "monetary", "display_currency": env.company.currency_id}'/>
            </td>
            <td t-if="o.env.context.get('force_valued_picking') and not ('valued_picking' in o.partner_id._fields and o.partner_id.valued_picking)" class="text-end">
                <span t-esc="move._get_conventional_report_line_total(move.product_uom_qty)"
                      t-options='{"widget": "monetary", "display_currency": env.company.currency_id}'/>
            </td>
        </xpath>
        <xpath expr="//table[@name='stock_move_line_table']/thead/tr/th[@name='th_sml_quantity']" position="after">
            <th t-if="o.env.context.get('force_valued_picking') and not ('valued_picking' in o.partner_id._fields and o.partner_id.valued_picking)" class="text-end"><strong>Precio</strong></th>
            <th t-if="o.env.context.get('force_valued_picking') and not ('valued_picking' in o.partner_id._fields and o.partner_id.valued_picking)" class="text-end"><strong>Neto</strong></th>
            <th t-if="o.env.context.get('force_valued_picking') and not ('valued_picking' in o.partner_id._fields and o.partner_id.valued_picking)" class="text-end"><strong>Importe</strong></th>
        </xpath>
        <xpath expr="//div[@t-if='not o.signature']" position="before">
            <div t-if="o.env.context.get('force_valued_picking')" class="clearfix" style="margin-top: 1rem;">
                <t t-set="report_totals" t-value="o._get_conventional_report_totals()"/>
                <div class="row">
                    <div class="col-6"/>
                    <div class="col-6">
                        <div class="table-responsive">
                            <table class="table table-sm" style="page-break-inside: avoid;">
                                <tr class="border-black">
                                    <td class="text-end"><strong>Subtotal</strong></td>
                                    <td class="text-end">
                                        <span t-esc="report_totals['subtotal']"
                                              t-options='{"widget": "monetary", "display_currency": env.company.currency_id}'/>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-end"><strong>IVA (21%)</strong></td>
                                    <td class="text-end">
                                        <span t-esc="report_totals['tax']"
                                              t-options='{"widget": "monetary", "display_currency": env.company.currency_id}'/>
                                    </td>
                                </tr>
                                <tr class="border-black o_total">
                                    <td class="text-end"><strong>Total con IVA</strong></td>
                                    <td class="text-end">
                                        <span t-esc="report_totals['total']"
                                              t-options='{"widget": "monetary", "display_currency": env.company.currency_id}'/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <template id="report_deliveryslip_valued_custom_v2">
        <t t-foreach="docs" t-as="doc">
            <t t-set="o" t-value="doc.with_context(force_valued_picking=True)"/>
            <t t-set="company" t-value="o.company_id"/>
            <t t-set="display_address" t-value="o.partner_id._display_address()"/>
            <html>
                <head>
                </head>
                <body>
                    <t t-call="todopintura_administration.report_delivery_header_footer"/>
                    <div class="page-content" style="margin-top: 120px;">
                        <t t-call="stock.report_delivery_document"/>
                    </div>
                </body>
            </html>
        </t>
    </template>

    <record id="pos_conventional_picking_integration.action_albaran_80mm" model="ir.actions.report">
        <field name="binding_model_id" eval="False"/>
    </record>

    <record id="action_custom_delivery_report_valued" model="ir.actions.report">
        <field name="name">Albarán Personalizado Valorado</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">todopintura_extend_pos_conventional.report_deliveryslip_valued_custom_v2</field>
        <field name="report_file">todopintura_extend_pos_conventional.report_deliveryslip_valued_custom_v2</field>
        <field name="print_report_name">'Albarán Personalizado Valorado - %s' % (object.name)</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
    </record>
</odoo>



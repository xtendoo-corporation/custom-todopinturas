<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_form_inherit_pos_observations" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.pos.observations</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/*[1]" position="before">
                <field name="partner_requires_voucher" invisible="1" />
                <field name="partner_voucher_reference" invisible="1" />
                <field name="partner_pickup_persons_display" invisible="1" />
                <field name="partner_pickup_persons_inline" invisible="1" />
                <field name="partner_current_total_due" invisible="1" />
                <field name="partner_credit_limit_amount" invisible="1" />
                <field name="partner_total_due_after_order" invisible="1" />
                <field name="partner_credit_warning_message" invisible="1" />

                <!-- Bloque Unificado de Avisos -->
                <div class="alert alert-warning mb-2"
                    role="alert"
                    invisible="not partner_id or (not partner_requires_voucher and not partner_pickup_persons_display and not partner_credit_warning_message and partner_current_total_due == 0 and partner_credit_limit_amount == 0)">

                    <!-- Fila 1: Vale y Autorizados -->
                    <div class="d-flex align-items-center gap-3"
                         invisible="not partner_requires_voucher and not partner_pickup_persons_display">
                        <span class="fa fa-exclamation-triangle" title="Aviso importante" />
                        <div class="flex-grow-1">
                            <div class="row">
                                <div class="col-12 col-md-6" invisible="not partner_requires_voucher">
                                    <div class="d-flex align-items-baseline gap-2">
                                        <span class="text-uppercase fw-bold"><span class="fa fa-ticket me-1" title="Vale" />VALE REQUERIDO:</span>
                                        <field name="partner_voucher_reference" readonly="1" nolabel="1" class="fw-bold text-warning-emphasis" />
                                        <span class="fw-bold" invisible="partner_voucher_reference">(pendiente)</span>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6 border-start border-warning-subtle" invisible="not partner_pickup_persons_display">
                                    <div class="d-flex align-items-baseline gap-2">
                                        <span class="text-uppercase fw-bold"><span class="fa fa-users me-1" title="Personas autorizadas" />AUTORIZADOS:</span>
                                        <field name="partner_pickup_persons_inline" readonly="1" nolabel="1" class="fw-bold" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Separador si hay ambos tipos de avisos -->
                    <hr class="my-1 border-warning-subtle"
                        invisible="not (partner_requires_voucher or partner_pickup_persons_display) or (not partner_credit_warning_message and partner_current_total_due == 0 and partner_credit_limit_amount == 0)" />

                    <!-- Fila 2: Información de Crédito -->
                    <div class="d-flex align-items-center gap-3"
                         invisible="not partner_credit_warning_message and partner_current_total_due == 0 and partner_credit_limit_amount == 0">
                        <span class="fa fa-info-circle" title="Información de crédito" />
                        <div class="text-nowrap"
                            invisible="partner_credit_limit_amount == 0 and partner_current_total_due == 0 and partner_total_due_after_order == 0 and not partner_credit_warning_message">
                            <span class="fw-semibold text-warning-emphasis">Estado de Crédito:</span>
                            Deuda <field name="partner_current_total_due" readonly="1" nolabel="1" /> ·
                            Límite <field name="partner_credit_limit_amount" readonly="1" nolabel="1" />
                            <span invisible="partner_total_due_after_order == partner_current_total_due">
                                · Proyectada <field name="partner_total_due_after_order" readonly="1" nolabel="1" />
                            </span>
                        </div>
                        <div class="text-nowrap fw-bold" invisible="not partner_credit_warning_message">
                            <span class="fa fa-exclamation-triangle me-1" />REVISAR CRÉDITO DEL CLIENTE:
                            <field name="partner_credit_warning_message" readonly="1" nolabel="1" class="ms-1" />
                        </div>
                    </div>
                </div>
            </xpath>
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Observaciones" name="pos_observations_page">
                    <group>
                        <field name="pos_observations" readonly="1"/>
                    </group>
                </page>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="domain">[('is_company', '=', True), ('parent_id', '=', False)]</attribute>
                <attribute name="context">{'res_partner_search_mode': 'customer', 'show_address': 1, 'show_vat': True, 'todopintura_company_partner_only': True}</attribute>
                <attribute name="options">{'no_create': True, 'no_create_edit': True}</attribute>
                <attribute name="widget">many2one</attribute>
            </xpath>
        </field>
    </record>
</odoo>

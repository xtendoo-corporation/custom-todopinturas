<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_form_inherit_pos_observations" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.pos.observations</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Observaciones" name="pos_observations_page">
                    <group>
                        <field name="pos_observations" readonly="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>


<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_pos_conventional_credit" model="ir.ui.view">
        <field name="name">res.partner.form.pos.conventional.credit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='sales_purchases']" position="after">
                <page string="POS convencional" name="pos_conventional_credit">
                    <group string="Crédito, cobro y recogida">
                        <group>
                            <field name="pos_credit_sale_enabled"/>
                            <field name="use_partner_credit_limit"/>
                            <field name="credit_limit"
                                   invisible="not use_partner_credit_limit"
                                   required="use_partner_credit_limit"/>
                            <field name="pos_credit_location_ids"
                                   widget="many2many_tags"
                                   invisible="not pos_credit_sale_enabled"
                                   options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="pos_requires_voucher"/>
                            <field name="pos_voucher_reference"
                                   invisible="not pos_requires_voucher"
                                   placeholder="Código o documento del vale"/>
                            <field name="pos_credit_location_names" readonly="1" invisible="1"/>
                        </group>
                    </group>
                    <group string="Autorizados de recogida">
                        <field name="pos_pickup_person_ids" context="{'default_partner_id': id}">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="name"/>
                                <field name="vat"/>
                                <field name="phone"/>
                                <field name="notes"/>
                                <field name="active" optional="hide"/>
                            </list>
                            <form>
                                <sheet>
                                    <group>
                                        <group>
                                            <field name="name"/>
                                            <field name="vat"/>
                                            <field name="phone"/>
                                        </group>
                                        <group>
                                            <field name="sequence"/>
                                            <field name="active"/>
                                        </group>
                                    </group>
                                    <group>
                                        <field name="notes"/>
                                    </group>
                                </sheet>
                            </form>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>


<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- El PIN del TPV ya no se guarda en el usuario: es el PIN del empleado. -->
    <record id="view_users_form_remove_pos_pin" model="ir.ui.view">
        <field name="name">res.users.form.todopintura.remove.pos.pin</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='pos_conventional_pin']" position="replace">

            </xpath>
        </field>
    </record>

    <record id="view_pos_session_pin_wizard_form_employee" model="ir.ui.view">
        <field name="name">pos.session.pin.wizard.form.todopintura.employee</field>
        <field name="model">pos.session.pin.wizard</field>
        <field name="inherit_id" ref="pos_conventional_users_pin.view_pos_session_pin_wizard_form"/>
        <field name="arch" type="xml">
            <xpath expr="//strong" position="replace">
                <strong>PIN de empleado</strong>
            </xpath>
            <xpath expr="//label[@for='pos_pin']" position="attributes">
                <attribute name="string">PIN del empleado</attribute>
            </xpath>
        </field>
    </record>
</odoo>

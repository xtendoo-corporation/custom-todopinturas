<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_make_payment_wizard_form_credit_warning" model="ir.ui.view">
        <field name="name">pos.make.payment.wizard.form.credit.warning</field>
        <field name="model">pos.make.payment.wizard</field>
        <field name="inherit_id" ref="pos_conventional_payment_wizard.view_pos_make_payment_wizard_form"/>
        <field name="arch" type="xml">
            <xpath expr="//separator[1]" position="before">
                <field name="show_credit_cashier_warning" invisible="1"/>
                <field name="credit_cashier_warning_message" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_pos_make_payment_wizard_cash_form_credit_warning" model="ir.ui.view">
        <field name="name">pos.make.payment.wizard.cash.form.credit.warning</field>
        <field name="model">pos.make.payment.wizard</field>
        <field name="inherit_id" ref="pos_conventional_payment_wizard.view_pos_make_payment_wizard_cash_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('p-3') and hasclass('mb-3')]" position="after">
                <field name="show_credit_cashier_warning" invisible="1"/>
                <field name="credit_cashier_warning_message" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>



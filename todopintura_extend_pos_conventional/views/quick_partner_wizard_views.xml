<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_conventional_quick_partner_wizard_form" model="ir.ui.view">
        <field name="name">pos.conventional.quick.partner.wizard.form</field>
        <field name="model">pos.conventional.quick.partner.wizard</field>
        <field name="arch" type="xml">
            <form string="Crear contacto rápido">
                <field name="order_id" invisible="1"/>
                <group>
                    <field name="name" placeholder="Nombre del cliente"/>
                    <field name="street"/>
                    <field name="phone" widget="phone"/>
                    <field name="email" widget="email"/>
                    <field name="pricelist_id" options="{'no_create': True, 'no_open': True}"/>
                </group>
                <footer>
                    <button string="Crear y asignar" name="action_create_partner" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Se añade a la rueda dentada del pedido desde JS (pos_order_quick_partner_cog_item.js)
         para que salga como primera opción; por eso no lleva binding_model_id. -->
    <record id="action_pos_conventional_quick_partner_wizard" model="ir.actions.act_window">
        <field name="name">Crear contacto rápido</field>
        <field name="res_model">pos.conventional.quick.partner.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_pos_conventional_quick_partner_wizard_form"/>
        <field name="binding_model_id" eval="False"/>
    </record>
</odoo>

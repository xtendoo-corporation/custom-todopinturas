<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_quant_pos_modal_tree" model="ir.ui.view">
        <field name="name">stock.quant.pos.modal.tree</field>
        <field name="model">stock.quant</field>
        <field name="arch" type="xml">
            <list string="Stock por Tiendas" create="false" edit="false" delete="false">
                <field name="warehouse_id" string="Tienda / Almacén" />
                <field name="location_id" string="Ubicación" optional="show" />
                <field name="available_quantity" string="Stock Disponible" decoration-success="available_quantity &gt; 0" />
                <field name="product_uom_id" string="Unidad" options="{'no_open': True}"/>
            </list>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_conventional_credit_override_wizard_form" model="ir.ui.view">
        <field name="name">pos.conventional.credit.override.wizard.form</field>
        <field name="model">pos.conventional.credit.override.wizard</field>
        <field name="arch" type="xml">
            <form string="Override de límite de riesgo" create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id" readonly="1"/>
                            <field name="current_due" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="payment_amount" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="total_after" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        </group>
                        <group>
                            <field name="credit_limit" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="current_location_name" readonly="1"/>
                            <field name="allowed_location_names" readonly="1" invisible="not allowed_location_names"/>
                            <field name="voucher_reference" readonly="1" invisible="not requires_voucher"/>
                        </group>
                    </group>
                    <group invisible="not pickup_people">
                        <field name="pickup_people" readonly="1" widget="text"/>
                    </group>
                    <group>
                        <field name="warning_message" readonly="1" widget="text"/>
                    </group>
                    <footer>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                        <button string="Continuar con override" name="action_confirm_override" type="object" class="btn-primary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pos_conventional_credit_override_wizard" model="ir.actions.act_window">
        <field name="name">Override de límite de riesgo</field>
        <field name="res_model">pos.conventional.credit.override.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_pos_conventional_credit_override_wizard_form"/>
    </record>
</odoo>


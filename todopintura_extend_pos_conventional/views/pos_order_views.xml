<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista antigua de cabecera: se sobrescribe y desactiva para upgrades -->
    <record id="view_pos_order_form_inherit_route_header" model="ir.ui.view">
        <field name="name">pos.order.form.inherit.route.header.obsolete</field>
        <field name="model">pos.order</field>
        <field name="active" eval="False" />
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lines']" position="attributes">
                <attribute name="readonly">state != 'draft'</attribute>
            </xpath>
        </field>
    </record>

    <!-- Recogida por línea del pedido -->
    <record id="view_pos_order_form_inherit_route_lines" model="ir.ui.view">
        <field name="name">pos.order.form.inherit.pickup.lines</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//page[@name='products']//field[@name='lines']/list//field[@name='product_id']"
                position="after">
                <field name="pickup_warehouse_id"
                    string="Tienda recogida"
                    domain="['|', ('company_id', '=', False), ('company_id', '=', parent.company_id)]"
                    options="{'no_create': True, 'no_open': True}" />
            </xpath>
            <xpath expr="//page[@name='products']//field[@name='lines']/list//field[@name='qty']"
                position="after">
                <field name="stock_status" column_invisible="True"/>
                <field name="display_qty_widget" column_invisible="True"/>
                <field name="free_qty_today" column_invisible="True"/>
                <field name="forecast_expected_date" column_invisible="True"/>
                <field name="is_mto" column_invisible="True"/>
                <field name="move_ids" column_invisible="True"/>
                <field name="qty_available_today" column_invisible="True"/>
                <field name="qty_to_deliver" column_invisible="True"/>
                <field name="scheduled_date" column_invisible="True"/>
                <field name="virtual_available_at_date" column_invisible="True"/>
                <field name="warehouse_id" column_invisible="True"/>
                <field name="stock_at_locations_json" column_invisible="True"/>
                <field name="state" column_invisible="True"/>

                <widget name="pos_qty_at_date_widget" width="20px" invisible="not display_qty_widget"/>
            </xpath>
            <xpath
                expr="//page[@name='products']//field[@name='lines']/form//field[@name='discount']"
                position="after">
                <field name="pickup_warehouse_id"
                    string="Tienda de recogida"
                    domain="['|', ('company_id', '=', False), ('company_id', '=', parent.company_id)]"
                    options="{'no_create': True, 'no_open': True}" />
            </xpath>
        </field>
    </record>

    <record id="view_pos_order_form_inherit_company_partner_domain" model="ir.ui.view">
        <field name="name">pos.order.form.inherit.company.partner.domain</field>
        <field name="model">pos.order</field>
        <field name="priority">130</field>
        <field name="inherit_id" ref="pos_conventional_core.view_pos_pos_form_inherit_pos_conventional_core" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="domain">[('is_company', '=', True), ('parent_id', '=', False)]</attribute>
                <attribute name="context">{'res_partner_search_mode': 'customer', 'show_address': False, 'show_vat': False, 'todopintura_company_partner_only': True}</attribute>
                <attribute name="options">{'no_create': True, 'no_create_edit': True}</attribute>
                <attribute name="widget">many2one</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_pos_order_form_inherit_credit_policy_panel" model="ir.ui.view">
        <field name="name">pos.order.form.inherit.credit.policy.panel</field>
        <field name="model">pos.order</field>
        <field name="priority">110</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form" />
        <field name="arch" type="xml">
            <xpath expr="//widget[@name='pos_cash_change_banner']" position="after">
                <field name="partner_current_total_due" invisible="1" />
                <field name="partner_credit_limit_amount" invisible="1" />
                <field name="partner_total_due_after_order" invisible="1" />
                <field name="partner_credit_available" invisible="1" />
                <field name="partner_credit_cashier_warning" invisible="1" />
                <field name="partner_requires_voucher" invisible="1" />
                <field name="partner_voucher_reference" invisible="1" />
                <field name="partner_pickup_persons_display" invisible="1" />
                <field name="partner_pickup_persons_inline" invisible="1" />
                <field name="partner_credit_warning_message" invisible="1" />
                <field name="current_credit_location_name" invisible="1" />
                <field name="partner_credit_location_names" invisible="1" />
                <div class="alert alert-info border-0 rounded-3 shadow-sm mb-3 py-2 px-3"
                    role="status"
                    invisible="not partner_id or is_linked_to_sale or (not partner_requires_voucher and not partner_pickup_persons_display and not partner_credit_warning_message and partner_current_total_due == 0 and partner_credit_limit_amount == 0)">
                    <div class="d-flex align-items-center gap-3 small flex-nowrap overflow-auto">
                        <div class="text-nowrap" invisible="not partner_requires_voucher">
                            <span class="fw-semibold">Vale:</span>
                            <field name="partner_voucher_reference" readonly="1" nolabel="1"
                                placeholder="Cliente con vale requerido" />
                        </div>
                        <div class="text-nowrap" invisible="not partner_pickup_persons_display">
                            <span class="fw-semibold">Autorizados:</span>
                            <field name="partner_pickup_persons_inline" readonly="1" nolabel="1" />
                        </div>
                        <div class="text-nowrap"
                            invisible="partner_credit_limit_amount == 0 and partner_current_total_due == 0 and partner_total_due_after_order == 0 and not partner_credit_warning_message">
                            <span class="fw-semibold">Crédito:</span> Deuda <field
                                name="partner_current_total_due" readonly="1" nolabel="1"
                                widget="monetary" options="{'currency_field': 'currency_id'}" /> ·
                            Límite <field name="partner_credit_limit_amount" readonly="1"
                                nolabel="1" widget="monetary"
                                options="{'currency_field': 'currency_id'}" />
                            <span
                                invisible="partner_total_due_after_order == partner_current_total_due">· Tras pedido <field
                                    name="partner_total_due_after_order" readonly="1" nolabel="1"
                                    widget="monetary" options="{'currency_field': 'currency_id'}" /></span>
                        </div>
                        <div class="text-nowrap" invisible="not partner_credit_warning_message">
                            <span class="fw-semibold">Aviso:</span> revisar crédito del cliente </div>
                    </div>
                </div>
            </xpath>
            <xpath expr="//page[@name='notes']" position="after">
                <page string="Información Extra del cliente" name="customer_extra_info">
                    <group invisible="not partner_id or is_linked_to_sale">
                        <group string="Crédito y cobro" name="credit_info">
                            <field name="partner_current_total_due" readonly="1" widget="monetary"
                                options="{'currency_field': 'currency_id'}" string="Deuda POS pendiente" />
                            <field name="partner_credit_limit_amount" readonly="1" widget="monetary"
                                options="{'currency_field': 'currency_id'}" string="Límite de riesgo" />
                            <field name="partner_total_due_after_order" readonly="1" widget="monetary"
                                options="{'currency_field': 'currency_id'}" string="Deuda tras el pedido" />
                            <field name="partner_credit_location_names" readonly="1"
                                invisible="not partner_credit_location_names" string="Venta a crédito permitida en" />
                            <field name="partner_credit_warning_message" readonly="1" widget="text"
                                invisible="not partner_credit_warning_message" string="Observación de crédito" />
                        </group>
                        <group string="Vale y recogida" name="pickup_info">
                            <field name="partner_requires_voucher" readonly="1" string="Necesita vale" />
                            <field name="partner_voucher_reference" readonly="1"
                                invisible="not partner_requires_voucher" string="Código / documento" />
                            <field name="partner_pickup_persons_display" readonly="1" widget="text"
                                invisible="not partner_pickup_persons_display" string="Autorizados de recogida" />
                        </group>
                    </group>
                    <div invisible="partner_id and not is_linked_to_sale">
                        <div class="alert alert-info border-0 rounded-3 shadow-sm mb-0"
                            role="status">
                            <span class="fa fa-circle-info me-2" title="Información" /> Selecciona
                            un cliente en el pedido para ver su información adicional. </div>
                    </div>
                </page>
            </xpath>
            <xpath expr="//page[@name='notes']" position="after">
                <page string="Observaciones" name="pos_observations_page">
                    <group>
                        <field name="pos_observations" widget="text"/>
                    </group>
                </page>
            </xpath>
            <xpath expr="//field[@name='pricelist_id']" position="after">
                <field name="is_a4_invoice" widget="boolean_toggle" invisible="state != 'draft'"/>
            </xpath>
        </field>
    </record>

    <record id="view_pos_order_form_inherit_paid_print_buttons" model="ir.ui.view">
        <field name="name">pos.order.form.inherit.paid.print.buttons</field>
        <field name="model">pos.order</field>
        <field name="priority">120</field>
        <field name="inherit_id" ref="pos_conventional_core.view_pos_pos_form_inherit_pos_conventional_core" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="can_print_paid_albaran" invisible="1"/>
                <field name="can_print_paid_invoice" invisible="1"/>
            </xpath>
            <xpath expr="//header/button[@name='action_print_factura_simplificada']" position="replace">
                <button name="action_print_paid_albaran"
                        string="Imprimir albarán"
                        type="object"
                        icon="fa-print"
                        class="btn-secondary"
                        invisible="not can_print_paid_albaran"/>
                <button name="action_print_paid_albaran_valued"
                        string="Imprimir albarán valorado"
                        type="object"
                        icon="fa-print"
                        class="btn-secondary"
                        invisible="not can_print_paid_albaran"/>
                <button name="action_print_paid_invoice"
                        string="Imprimir factura"
                        type="object"
                        icon="fa-print"
                        class="btn-secondary"
                        invisible="not can_print_paid_invoice"/>
            </xpath>
        </field>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_conventional_credit_cashier_warning_wizard_form" model="ir.ui.view">
        <field name="name">pos.conventional.credit.cashier.warning.wizard.form</field>
        <field name="model">pos.conventional.credit.cashier.warning.wizard</field>
        <field name="arch" type="xml">
            <form string="Cliente con crédito disponible" create="0" edit="0">
                <sheet>
                    <field name="order_id" readonly="1" invisible="1"/>
                    <field name="partner_id" readonly="1" invisible="1"/>
                    <field name="revert_partner_id" readonly="1" invisible="1"/>
                    <field name="payment_method_id" readonly="1" invisible="1"/>
                    <div class="alert alert-warning border-3 rounded-3 shadow-sm mb-3 py-3 px-4" role="alert">
                        <div class="d-flex align-items-start gap-3">
                            <span class="fa fa-exclamation-triangle fa-2x mt-1" title="Aviso"/>
                            <div>
                                <div class="fw-bold fs-4 text-uppercase mb-1">Revise el método de cobro antes de continuar</div>
                                <field name="warning_message" readonly="1" widget="text" nolabel="1" class="mb-0"/>
                            </div>
                        </div>
                    </div>
                </sheet>
                <footer>
                    <button string="Cancelar" name="action_cancel" type="object" class="btn-secondary"/>
                    <button string="Continuar" name="action_continue" type="object" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pos_conventional_credit_cashier_warning_wizard" model="ir.actions.act_window">
        <field name="name">Cliente con crédito disponible</field>
        <field name="res_model">pos.conventional.credit.cashier.warning.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_pos_conventional_credit_cashier_warning_wizard_form"/>
    </record>
</odoo>


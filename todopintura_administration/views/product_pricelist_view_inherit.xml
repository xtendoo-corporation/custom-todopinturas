<odoo>
    <record id="product_pricelist_view_inherit" model="ir.ui.view">
        <field name="name">product.pricelist.view.inherit</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product.product_pricelist_view"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='base']" position="replace">
            </xpath>
             <xpath expr="//list/field[@name='applied_on']" position="replace">
            </xpath>

             <xpath expr="//list/field[@name='price']" position="replace">
                    <field name="price" string="Precio" required='1' invisible="not compute_price == 'fixed'"
                           optional="show"/>
            </xpath>
            <xpath expr="//list/field[@name='price']" position="before">
                    <field name="compute_price" string="Tipo Cálculo" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='price']" position="after">
                <field name="percent_price" invisible="not compute_price == 'percentage'" string="Desc %"
                       optional="show"/>
                <field name="base" invisible="not compute_price == 'formula'" optional="show"/>
                <field name="base_pricelist_id" invisible="not compute_price == 'formula' or not base == 'pricelist'"
                       string="Otra Tarifa" optional="show"/>
                <field name="price_discount" invisible="not compute_price == 'formula'" string="Desc %"
                       optional="show"/>
            </xpath>
            <!-- Añadimos controles de filtrado inline antes de las líneas (filtro cliente-side mediante JS) -->
            <xpath expr="//field[@name='item_ids']" position="before">
                <!-- Placeholder container for the inline filter controls. JS will inject
                     the inputs/buttons here at runtime so the view XML stays valid. -->
                <div class="todopintura-pricelist-filter" style="margin-bottom:10px;"/>
            </xpath>

            <!-- No se añade botón en el header: el buscador inline se insertará antes del one2many -->
        </field>
    </record>

    <!-- Acción que muestra las líneas de tarifa en una vista separada para permitir búsquedas por producto, plantilla o categoría -->
    <record id="action_product_pricelist_item_lines_todopintura" model="ir.actions.act_window">
        <field name="name">Líneas de Tarifa</field>
        <field name="res_model">product.pricelist.item</field>
        <field name="view_mode">tree,form</field>
        <field name="target">current</field>
    </record>

</odoo>

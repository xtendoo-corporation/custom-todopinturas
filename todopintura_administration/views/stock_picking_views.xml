<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- El botón Imprimir de un albarán hecho usa el albarán Todo Pintura en lugar del estándar -->
    <record id="view_picking_form_print_albaran_todopintura" model="ir.ui.view">
        <field name="name">stock.picking.form.print.albaran.todopintura</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='%(stock.action_report_delivery)d']" position="attributes">
                <attribute name="name" separator="">%(todopintura_administration.action_report_albaran_todopintura)d</attribute>
            </xpath>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Vista formulario para conteo -->
    <record id="view_stock_count_form" model="ir.ui.view">
        <field name="name">stock.count.form</field>
        <field name="model">stock.count</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" string="Iniciar" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_done" string="Finalizar" type="object"
                            class="oe_highlight" invisible="state != 'in_progress'"/>
                    <button name="action_resume" string="Reanudar" type="object"
                            class="oe_highlight" invisible="state != 'in_progress'"/>
                     <button name="action_reopen" string="Volver a En Progreso" type="object"
                        class="oe_highlight" invisible="state != 'done'"/>
                    <button name="action_cancel" string="Cancelar" type="object"
                            invisible="state not in ['draft', 'in_progress']"/>
                    <button name="action_draft" string="Volver a Borrador" type="object"
                            invisible="state != 'cancel'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="date_start"/>
                            <field name="date_end" readonly="1" invisible="state != 'done'"/>
                        </group>
                        <group>
                            <field name="location_id" options="{'no_create': True}"/>
                            <field name="zone"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Líneas de conteo">
                            <field name="line_ids" readonly="True">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                >
            </form>
        </field>
    </record>

    <!-- Vista lista para conteo -->
    <record id="view_stock_count_tree" model="ir.ui.view">
        <field name="name">stock.count.tree</field>
        <field name="model">stock.count</field>
        <field name="arch" type="xml">
            <list decoration-info="state=='draft'"
                  decoration-warning="state=='in_progress'"
                  decoration-success="state=='done'"
                  decoration-muted="state=='cancel'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="location_id"/>
                <field name="zone"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Vista búsqueda para conteo -->
    <record id="view_stock_count_search" model="ir.ui.view">
        <field name="name">stock.count.search</field>
        <field name="model">stock.count</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="location_id"/>
                <filter string="No completados" name="not_done" domain="[('state','!=','done')]"/>
                <filter string="Borrador" name="draft" domain="[('state','=','draft')]"/>
                <filter string="En Progreso" name="in_progress" domain="[('state','=','in_progress')]"/>
                <filter string="Completado" name="done" domain="[('state','=','done')]"/>
                <filter string="Cancelado" name="cancel" domain="[('state','=','cancel')]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Empleado" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Ubicación" name="group_location" context="{'group_by': 'location_id'}"/>
                    <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción y menú -->
    <record id="action_stock_count" model="ir.actions.act_window">
        <field name="name">Conteo</field>
        <field name="res_model">stock.count</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_not_done': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea un nuevo conteo de inventario
            </p>
        </field>
    </record>

    <!-- Entrada de menú para conteos -->
    <menuitem id="menu_stock_count"
              name="Conteo"
              action="action_stock_count"
              parent="stock.menu_stock_warehouse_mgmt"
              sequence="100"/>

    <!-- Secuencia para conteos -->
    <record id="seq_stock_count" model="ir.sequence">
        <field name="name">Conteo de Inventario</field>
        <field name="code">stock.count</field>
        <field name="prefix">CONT/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>

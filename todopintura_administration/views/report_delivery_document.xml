<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- 1. Herencia de la plantilla principal -->
    <template id="report_delivery_document_custom" inherit_id="stock.report_delivery_document">
        <!-- Cambiar el título del albarán -->
        <xpath expr="//h2/span[@t-field='o.name']" position="replace">
            <t t-if="o.name">
                <span t-esc="'ALBARÁN Nº ' + o.name.split('/')[-1]"/>
            </t>
            <t t-else="">
                <span t-field="o.name"/>
            </t>
        </xpath>

        <!-- Ocultar la columna Entregado sin eliminar los nodos ancla que usan otras herencias -->
        <xpath expr="//table[@name='stock_move_table']/thead/tr/th[@name='th_sm_quantity']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//table[@name='stock_move_table']/thead/tr/th[@name='th_sm_quantity']" position="after">
            <th t-if="'valued_picking' in o.partner_id._fields and o.partner_id.valued_picking" name="th_sm_price" class="text-end">Precio</th>
            <th t-if="'valued_picking' in o.partner_id._fields and o.partner_id.valued_picking" name="th_sm_subtotal" class="text-end">Neto</th>
            <th t-if="'valued_picking' in o.partner_id._fields and o.partner_id.valued_picking" name="th_sm_total" class="text-end">Importe</th>
        </xpath>

        <xpath expr="//table[@name='stock_move_table']/tbody/tr/td[3]" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//table[@name='stock_move_table']/tbody/tr/td[3]" position="after">
            <td t-if="'valued_picking' in o.partner_id._fields and o.partner_id.valued_picking" class="text-end">
                <span t-esc="move.sale_line_id.price_unit * (1 - (move.sale_line_id.discount or 0.0) / 100)"
                      t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
            </td>
            <td t-if="'valued_picking' in o.partner_id._fields and o.partner_id.valued_picking" class="text-end">
                <span t-esc="move.sale_line_id.price_unit * (1 - (move.sale_line_id.discount or 0.0) / 100)"
                      t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
            </td>
            <td t-if="'valued_picking' in o.partner_id._fields and o.partner_id.valued_picking" class="text-end">
                <span
                    t-esc="move.sale_line_id.price_unit * move.product_uom_qty * (1 - (move.sale_line_id.discount or 0.0) / 100)"
                    t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
            </td>
        </xpath>

        <!-- Ocultar Entregado también en albaranes completados, manteniendo anclas para otras vistas -->
        <xpath expr="//table[@name='stock_move_line_table']/thead/tr/th[@name='th_sml_quantity']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//table[@name='stock_move_line_table']/thead/tr/th[@name='th_sml_quantity']" position="after">
            <th t-if="'valued_picking' in o.partner_id._fields and o.partner_id.valued_picking" name="th_sml_price" class="text-center">Precio</th>
            <th t-if="'valued_picking' in o.partner_id._fields and o.partner_id.valued_picking" name="th_sml_subtotal" class="text-center">Neto</th>
            <th t-if="'valued_picking' in o.partner_id._fields and o.partner_id.valued_picking" name="th_sml_total" class="text-center">Importe</th>
        </xpath>
    </template>

    <!-- 2. Herencia del template para líneas con números de serie -->
    <template id="stock_report_delivery_has_serial_move_line_custom"
              inherit_id="stock.stock_report_delivery_has_serial_move_line">
        <xpath expr="//td[@name='move_line_lot_quantity']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//td[@name='move_line_lot_quantity']" position="after">
            <td t-if="'valued_picking' in o.partner_id._fields and o.partner_id.valued_picking" class="text-center">
                <span
                    t-esc="move_line.move_id.sale_line_id.price_unit * (1 - (move_line.move_id.sale_line_id.discount or 0.0) / 100)"
                    t-options='{"widget": "monetary", "display_currency": env.company.currency_id}'/>
            </td>
            <td t-if="'valued_picking' in o.partner_id._fields and o.partner_id.valued_picking" class="text-center">
                <span
                    t-esc="move_line.move_id.sale_line_id.price_unit * (1 - (move_line.move_id.sale_line_id.discount or 0.0) / 100)"
                    t-options='{"widget": "monetary", "display_currency": env.company.currency_id}'/>
            </td>
            <td t-if="'valued_picking' in o.partner_id._fields and o.partner_id.valued_picking" class="text-center">
                <span
                    t-esc="move_line.move_id.sale_line_id.price_unit * move_line.qty_done * (1 - (move_line.move_id.sale_line_id.discount or 0.0) / 100)"
                    t-options='{"widget": "monetary", "display_currency": env.company.currency_id}'/>
            </td>
        </xpath>
    </template>

    <!-- 3. Herencia del template para líneas agregadas -->
    <template id="stock_report_delivery_aggregated_move_lines_custom"
              inherit_id="stock.stock_report_delivery_aggregated_move_lines">
        <xpath expr="//td[@name='move_line_aggregated_quantity']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//td[@name='move_line_aggregated_quantity']" position="after">
            <td t-if="'valued_picking' in o.partner_id._fields and o.partner_id.valued_picking" class="text-center">
                <t t-set="move"
                   t-value="env['stock.move'].search([('product_id', '=', aggregated_lines[line]['product'].id), ('picking_id', '=', o.id)], limit=1)"/>
                <t t-set="price_unit" t-value="move.sale_line_id.price_unit if move.sale_line_id else 0.0"/>
                <t t-set="discount" t-value="move.sale_line_id.discount if move.sale_line_id else 0.0"/>
                <t t-set="price_with_discount" t-value="price_unit * (1 - discount / 100) if discount else price_unit"/>
                <span t-esc="price_with_discount"
                      t-options='{"widget": "monetary", "display_currency": env.company.currency_id}'/>
            </td>
            <td t-if="'valued_picking' in o.partner_id._fields and o.partner_id.valued_picking" class="text-center">
                <span t-esc="price_with_discount"
                      t-options='{"widget": "monetary", "display_currency": env.company.currency_id}'/>
            </td>
            <td t-if="'valued_picking' in o.partner_id._fields and o.partner_id.valued_picking" class="text-center">
                <span t-esc="price_with_discount * aggregated_lines[line]['qty_done']"
                      t-options='{"widget": "monetary", "display_currency": env.company.currency_id}'/>
            </td>
        </xpath>
    </template>



    <template id="todopintura_administration.report_deliveryslip_custom">
        <t t-foreach="docs" t-as="o">
            <t t-set="company" t-value="o.company_id"/>
            <t t-set="display_address" t-value="o.partner_id._display_address()"/>
            <html>
                <head>
                </head>
                <body>
                    <!-- Se llama al template base (header y footer) -->
                    <t t-call="todopintura_administration.report_delivery_header_footer"/>
                    <!-- Contenedor del contenido del albarán -->
                    <div class="page-content" style="margin-top: 120px;">
                        <t t-call="stock.report_delivery_document"/>
                    </div>
                </body>
            </html>
        </t>
    </template>

    <record id="action_custom_delivery_report" model="ir.actions.report">
        <field name="name">Albarán Personalizado</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">todopintura_administration.report_deliveryslip_custom</field>
        <field name="report_file">todopintura_administration.report_deliveryslip_custom</field>
        <field name="print_report_name">'Albarán Personalizado - %s' % (object.name)</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
    </record>
</odoo>

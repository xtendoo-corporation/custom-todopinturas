<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_delivery_document_custom" inherit_id="stock.report_delivery_document">
        <xpath expr="//t[@t-call='web.external_layout']" position="before">
            <t t-set="is_valued" t-value="o.env.context.get('force_valued_picking') or (o.partner_id and o.partner_id.delivery_report_print_type == 'valued')"/>
        </xpath>
        <xpath expr="//h2" position="replace">
            <h2>
                <t t-if="o.name">
                    <span t-esc="'ALBARÁN Nº ' + o.name.split('/')[-1]"/>
                </t>
                <t t-else="">
                    <span t-field="o.name"/>
                </t>
            </h2>
        </xpath>
        <xpath expr="//table[@name='stock_move_table']/thead/tr/th[@name='th_sm_quantity']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//table[@name='stock_move_table']/thead/tr/th[@name='th_sm_quantity']" position="after">
            <th t-if="is_valued" name="th_sm_price" class="text-end">Precio unidad</th>
            <th t-if="is_valued" name="th_sm_subtotal" class="text-end">Neto</th>
            <th t-if="is_valued" name="th_sm_total" class="text-end">Importe</th>
        </xpath>
        <xpath expr="//table[@name='stock_move_table']/tbody/tr/td[3]" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//table[@name='stock_move_table']/tbody/tr/td[3]" position="after">
            <td t-if="is_valued" name="td_sm_price" class="text-end">
                <span t-esc="move._get_conventional_report_price_unit()"
                      t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
            </td>
            <td t-if="is_valued" name="td_sm_subtotal" class="text-end">
                <span t-esc="move._get_conventional_report_discounted_price()"
                      t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
            </td>
            <td t-if="is_valued" name="td_sm_total" class="text-end">
                <span t-esc="move._get_conventional_report_line_total_included()"
                    t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
            </td>
        </xpath>
        <xpath expr="//table[@name='stock_move_line_table']/thead/tr/th[@name='th_sml_quantity']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//table[@name='stock_move_line_table']/thead/tr/th[@name='th_sml_quantity']" position="after">
            <th t-if="is_valued" name="th_sml_price" class="text-center">Precio unidad</th>
            <th t-if="is_valued" name="th_sml_subtotal" class="text-center">Neto</th>
            <th t-if="is_valued" name="th_sml_total" class="text-center">Importe</th>
        </xpath>
    </template>
    <template id="stock_report_delivery_has_serial_move_line_custom"
              inherit_id="stock.stock_report_delivery_has_serial_move_line">
        <xpath expr="//td[@name='move_line_lot_quantity']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//td[@name='move_line_lot_quantity']" position="after">
            <t t-set="is_valued" t-value="env.context.get('force_valued_picking') or (o.partner_id and o.partner_id.delivery_report_print_type == 'valued')"/>
            <td t-if="is_valued" name="td_sml_price" class="text-center">
                <span t-esc="move_line.move_id._get_conventional_report_price_unit()"
                    t-options='{"widget": "monetary", "display_currency": env.company.currency_id}'/>
            </td>
            <td t-if="is_valued" name="td_sml_subtotal" class="text-center">
                <span t-esc="move_line.move_id._get_conventional_report_discounted_price()"
                    t-options='{"widget": "monetary", "display_currency": env.company.currency_id}'/>
            </td>
            <td t-if="is_valued" name="td_sml_total" class="text-center">
                <span t-esc="move_line.move_id._get_conventional_report_line_total_included(quantity=move_line.quantity)"
                    t-options='{"widget": "monetary", "display_currency": env.company.currency_id}'/>
            </td>
        </xpath>
    </template>
    <template id="stock_report_delivery_aggregated_move_lines_custom"
              inherit_id="stock.stock_report_delivery_aggregated_move_lines">
        <xpath expr="//td[@name='move_line_aggregated_quantity']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//td[@name='move_line_aggregated_quantity']" position="after">
            <t t-set="is_valued" t-value="env.context.get('force_valued_picking') or (o.partner_id and o.partner_id.delivery_report_print_type == 'valued')"/>
            <td t-if="is_valued" name="td_sm_aggregated_price" class="text-center">
                <t t-set="move" t-value="o._get_conventional_report_aggregated_move(aggregated_lines[line])"/>
                <span t-esc="move._get_conventional_report_price_unit()"
                      t-options='{"widget": "monetary", "display_currency": env.company.currency_id}'/>
            </td>
            <td t-if="is_valued" name="td_sm_aggregated_subtotal" class="text-center">
                <span t-esc="move._get_conventional_report_discounted_price()"
                      t-options='{"widget": "monetary", "display_currency": env.company.currency_id}'/>
            </td>
            <td t-if="is_valued" name="td_sm_aggregated_total" class="text-center">
                <span t-esc="move._get_conventional_report_line_total_included(quantity=aggregated_lines[line]['quantity'])"
                      t-options='{"widget": "monetary", "display_currency": env.company.currency_id}'/>
            </td>
        </xpath>
    </template>

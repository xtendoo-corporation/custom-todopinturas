<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_users_form_inherit_main_warehouse" model="ir.ui.view">
        <field name="name">res.users.form.inherit.main.warehouse</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Almacén">
                    <field name="main_warehouse_id" options="{'no_create': True}"/>
                </group>
            </xpath>
        </field>
    </record>
    <record id="view_res_users_form_inherit_pos_can_edit_price_admin" model="ir.ui.view">
        <field name="name">res.users.form.inherit.pos.can.edit.price.admin</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <!-- Insertar dentro del sheet para asegurar que la vista siempre se aplica
                 (no hacer xpath directo contra campos añadidos por otros módulos,
                 porque podrían no existir en el momento de cargar la vista). -->
            <xpath expr="//sheet" position="inside">
                <group string="Punto de Venta">
                    <field name="pos_can_edit_price"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>


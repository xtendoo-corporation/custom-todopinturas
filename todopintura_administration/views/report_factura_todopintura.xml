<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_factura_todopintura_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang or o.env.lang)"/>
                <t t-set="partner" t-value="o.partner_id"/>
                <t t-set="summary" t-value="o._tp_report_tax_summary()"/>
                <t t-call="todopintura_administration.external_layout_todopintura">
                    <div class="page tp_doc tp_factura" style="font-size: 11px; color: #1c2b5a;">
                        <t t-call="todopintura_administration.tp_document_top_boxes">
                            <t t-set="copy_label" t-value="False"/>
                            <t t-set="salesperson" t-value="o.invoice_user_id"/>
                            <t t-set="right_block">
                                <div><span t-out="o.invoice_date or o.date" t-options='{"widget": "date", "format": "dd/MM/yy"}'/></div>
                                <div style="margin-top: 8px;">
                                    <strong t-out="o._tp_report_title()"/>
                                    <span style="margin-left: 10px;" t-out="o.name if o.name and o.name != '/' else 'BORRADOR'"/>
                                </div>
                                <div style="margin-top: 4px;"><strong>Forma de pago:</strong> <span t-out="o.invoice_payment_term_id.name or ''"/></div>
                                <div><strong>Domicilio de pago:</strong> <span t-out="o.partner_bank_id.acc_number or ''"/></div>
                                <div t-if="o.ref or o.payment_reference"><strong>REFERENCIA:</strong> <span t-out="o.ref or o.payment_reference"/></div>
                                <div t-if="o.narration" style="margin-top: 4px;" t-field="o.narration"/>
                            </t>
                        </t>

                        <table class="tp_box" style="width: 100%; border-collapse: collapse;">
                            <thead>
                                <tr>
                                    <th style="padding: 4px 6px;">CONCEPTO</th>
                                    <th class="text-end" style="padding: 4px 6px;">CANTIDAD</th>
                                    <th class="text-center" style="padding: 4px 6px;">TAMAÑO</th>
                                    <th class="text-end" style="padding: 4px 6px;">PRECIO</th>
                                    <th class="text-end" style="padding: 4px 6px;">DTO.</th>
                                    <th class="text-end" style="padding: 4px 6px;">NETO</th>
                                    <th class="text-end" style="padding: 4px 6px;">IMPORTE</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.invoice_line_ids.sorted('sequence')" t-as="line">
                                    <tr t-if="line.display_type in ('line_section', 'line_subsection', 'line_note')">
                                        <td colspan="7" style="padding: 2px 6px;"><strong t-out="line.name"/></td>
                                    </tr>
                                    <tr t-elif="line.display_type == 'product'">
                                        <td style="padding: 2px 6px;"><span t-out="line.name"/></td>
                                        <td class="text-end" style="padding: 2px 6px;"><span t-out="line.quantity" t-options='{"widget": "float", "precision": 0}' t-if="line.quantity == int(line.quantity)"/><span t-else="" t-out="line.quantity"/></td>
                                        <td class="text-center" style="padding: 2px 6px;"><span t-out="line.product_uom_id.name or ''"/></td>
                                        <td class="text-end" style="padding: 2px 6px;"><span t-out="line.price_unit" t-options='{"widget": "float", "precision": 2}'/></td>
                                        <td class="text-end" style="padding: 2px 6px;"><span t-if="line.discount" t-out="line.discount" t-options='{"widget": "float", "precision": 2}'/></td>
                                        <td class="text-end" style="padding: 2px 6px;"><span t-out="line.price_unit * (1 - (line.discount or 0.0) / 100.0)" t-options='{"widget": "float", "precision": 2}'/></td>
                                        <td class="text-end" style="padding: 2px 6px;"><span t-out="line.price_subtotal" t-options='{"widget": "float", "precision": 2}'/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <table class="tp_box" style="width: 100%; margin-top: 8px;">
                            <tr>
                                <th style="padding: 3px 6px;">BASE</th>
                                <th style="padding: 3px 6px;">IVA</th>
                                <th style="padding: 3px 6px;">IMPORTE IVA</th>
                                <th t-if="summary['recargo']" style="padding: 3px 6px;">% RE</th>
                                <th t-if="summary['recargo']" style="padding: 3px 6px;">IMPORTE RE</th>
                                <th class="text-end" style="padding: 3px 6px;">TOTAL FACTURA</th>
                            </tr>
                            <tr>
                                <td style="padding: 3px 6px;"><span t-out="summary['base']" t-options='{"widget": "float", "precision": 2}'/></td>
                                <td style="padding: 3px 6px;">
                                    <t t-foreach="summary['iva']" t-as="rate_amount"><div><span t-out="rate_amount[0]" t-options='{"widget": "float", "precision": 0}'/> %</div></t>
                                </td>
                                <td style="padding: 3px 6px;">
                                    <t t-foreach="summary['iva']" t-as="rate_amount"><div><span t-out="rate_amount[1]" t-options='{"widget": "float", "precision": 2}'/></div></t>
                                </td>
                                <td t-if="summary['recargo']" style="padding: 3px 6px;">
                                    <t t-foreach="summary['recargo']" t-as="rate_amount"><div><span t-out="rate_amount[0]" t-options='{"widget": "float", "precision": 1}'/> %</div></t>
                                </td>
                                <td t-if="summary['recargo']" style="padding: 3px 6px;">
                                    <t t-foreach="summary['recargo']" t-as="rate_amount"><div><span t-out="rate_amount[1]" t-options='{"widget": "float", "precision": 2}'/></div></t>
                                </td>
                                <td class="text-end" style="padding: 3px 6px; font-weight: bold;"><span t-out="summary['total']" t-options='{"widget": "float", "precision": 2}'/></td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_factura_todopintura" model="ir.actions.report">
        <field name="name">Factura Todo Pintura</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">todopintura_administration.report_factura_todopintura_document</field>
        <field name="report_file">todopintura_administration.report_factura_todopintura_document</field>
        <field name="print_report_name">(object._get_report_base_filename())</field>
        <field name="paperformat_id" ref="todopintura_administration.paperformat_todopintura_a4"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
    </record>
</odoo>

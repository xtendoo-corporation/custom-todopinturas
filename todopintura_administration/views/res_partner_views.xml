<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_partner_form_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='internal_notes']" position="after">
                <page name="assigned_persons" string="Personas asignadas" invisible="not is_company">
                    <group>
                        <field name="contact_to_assign_ids" widget="many2many_tags"
                               options="{'no_create': True}"
                               placeholder="Seleccione contactos a asignar"/>
                        <button string="Asignar contactos seleccionados"
                                name="action_add_existing_contacts"
                                type="object"
                                class="btn-primary"
                                invisible="not contact_to_assign_ids"/>
                    </group>
                    <separator string="Personas actualmente asignadas"/>
                    <field name="assigned_person_ids" context="{'default_parent_id': id}" mode="tree,form">
                        <list>
                            <field name="name"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="vat"/>
                        </list>
                        <form>
                            <sheet>
                                <group>
                                    <field name="name"/>
                                    <field name="email"/>
                                    <field name="phone"/>
                                    <field name="vat"/>
                                </group>
                            </sheet>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>

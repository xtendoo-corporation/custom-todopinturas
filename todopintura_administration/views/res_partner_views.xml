<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_partner_form_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='internal_notes']" position="after">

                <page name="assigned_persons" string="Personas asignadas"
                      modifiers="{'invisible': [('is_company', '=', False)]}">
                    <field name="assigned_person_ids" context="{'default_parent_id': id}" mode="tree,form">
                        <tree string="Assigned Persons">
                            <field name="name"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="vat"/>
                        </tree>
                        <form string="Assigned Person">
                            <sheet>
                                <group>
                                    <field name="name"/>
                                    <field name="email"/>
                                    <field name="phone"/>
                                    <field name="vat"/>
                                </group>
                            </sheet>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>

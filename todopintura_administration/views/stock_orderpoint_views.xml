<odoo>
    <record id="view_warehouse_orderpoint_tree_editable_inherit" model="ir.ui.view">
        <field name="name">stock.warehouse.orderpoint.tree.editable.inherit</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="inherit_id" ref="stock.view_warehouse_orderpoint_tree_editable" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_min_qty']" position="before">
                <button name="action_view_stock_min_dates" type="object" string="Stock por Fechas"
                    class="" />
            </xpath>
        </field>
    </record>

    <record id="warehouse_orderpoint_search_inherited" model="ir.ui.view">
        <field name="name">stock.warehouse.orderpoint.search.inherited</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="inherit_id" ref="stock.warehouse_orderpoint_search" />
        <field name="arch" type="xml">
            <filter name="inactive" position="after">
                <filter string="Bajo mínimos" name="below_min_qty"
                    domain="[('is_below_min', '=', True)]" />
            </filter>
        </field>
    </record>

    <!-- Modificar la acción para incluir el filtro por defecto -->
    <record id="stock.action_orderpoint" model="ir.actions.act_window">
        <field name="context">{'search_default_below_min_qty': 1}</field>
    </record>
</odoo>
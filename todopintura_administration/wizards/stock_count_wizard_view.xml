<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_stock_count_wizard_form" model="ir.ui.view">
        <field name="name">stock.count.wizard.form</field>
        <field name="model">stock.count.wizard</field>
        <field name="arch" type="xml">
            <form string="Conteo de Productos">
                <field name="count_id" invisible="1"/>
                <group>
                    <group>
                        <field name="product_id"/>
                        <field name="product_default_code" readonly="1"/>
                        <field name="product_barcode" readonly="1"/>
                    </group>
                    <group>
                        <field name="quantity"/>
                    </group>
                </group>
                <footer>
                    <button name="action_add_product" string="Añadir y Continuar" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

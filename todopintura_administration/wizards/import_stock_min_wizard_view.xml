<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_import_stock_min_wizard" model="ir.ui.view">
        <field name="name">import.stock.min.wizard.form</field>
        <field name="model">import.stock.min.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar Stock Mínimo">
                <group>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="file" filename="file_name"/>
                </group>
                <group>
                    <field name="error_log" nolabel="1" readonly="1" widget="text"/>
                </group>
                <footer>
                    <button name="action_import_stock_min" string="Importar" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

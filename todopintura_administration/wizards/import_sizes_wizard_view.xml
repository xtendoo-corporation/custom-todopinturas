<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_import_sizes_wizard" model="ir.ui.view">
        <field name="name">import.sizes.wizard.form</field>
        <field name="model">import.sizes.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar Tamaños">
                <group invisible="state != 'upload'">
                    <field name="state" invisible="1"/>
                    <field name="file" filename="file_name"/>
                    <div class="text-muted">
                        Columnas: A = código de tamaño (son los 3 últimos dígitos del código de producto), B = descripción (p. ej. "5 Kg/Lt").
                        El código 0 ("--", sin tamaño) se ignora. Si el código ya existe se actualiza el nombre.
                    </div>
                </group>
                <group invisible="state != 'done'">
                    <field name="created_count"/>
                    <field name="updated_count"/>
                    <field name="error_count"/>
                    <field name="log" nolabel="1" colspan="2"/>
                </group>
                <footer>
                    <button name="action_import_sizes" string="Importar" type="object"
                            class="btn-primary" invisible="state != 'upload'"/>
                    <button string="Cerrar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

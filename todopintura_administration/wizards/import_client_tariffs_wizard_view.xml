<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_import_client_tariffs_wizard" model="ir.ui.view">
        <field name="name">import.client.tariffs.wizard.form</field>
        <field name="model">import.client.tariffs.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar Tarifas de clientes">
                <group>
                    <field name="file" filename="file_name"/>
                </group>
                 <group>
                    <field name="error_log" invisible="not error_log"/>
                </group>
                <footer>
                    <button name="action_import_tariffs" string="Importar" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

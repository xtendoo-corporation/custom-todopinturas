                <attribute name="groups">todopintura_user_groups.group_cost_viewer</attribute>
            </xpath>
        </field>
    </record>

    <!-- POS: the margin fields are restricted in the model; the stored total cost
         is only hidden in the view because it is written when orders are created. -->
    <record id="view_pos_pos_form_costs" model="ir.ui.view">
        <field name="name">pos.order.form.costs</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='total_cost']" position="attributes">
                <attribute name="groups">todopintura_user_groups.group_cost_viewer</attribute>
            </xpath>
        </field>
    </record>
</odoo>

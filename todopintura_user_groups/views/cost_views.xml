    </record>

    <record id="product_supplierinfo_kanban_view_costs" model="ir.ui.view">
        <field name="name">product.supplierinfo.kanban.costs</field>
        <field name="model">product.supplierinfo</field>
        <field name="inherit_id" ref="product.product_supplierinfo_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='price']" position="attributes">
                <attribute name="groups">todopintura_user_groups.group_cost_viewer</attribute>
            </xpath>
        </field>
    </record>

    <record id="product_supplierinfo_tree_view_costs" model="ir.ui.view">
        <field name="name">product.supplierinfo.list.costs</field>
        <field name="model">product.supplierinfo</field>

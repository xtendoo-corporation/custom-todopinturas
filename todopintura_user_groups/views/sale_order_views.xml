<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Locked profiles (see models/commercial_lock.py): terms, prices and discounts are read-only. -->
    <record id="view_order_form_commercial_lock" model="ir.ui.view">
        <field name="name">sale.order.form.todopintura.lock</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="attributes">
                <attribute name="readonly">todopintura_locked</attribute>
            </xpath>
            <xpath expr="//field[@name='payment_mode_id']" position="attributes">
                <attribute name="readonly">todopintura_locked</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="todopintura_locked" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list//field[@name='price_unit']" position="attributes">
                <attribute name="readonly">qty_invoiced &gt; 0 or parent.todopintura_locked</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list//field[@name='discount']" position="attributes">
                <attribute name="readonly">parent.todopintura_locked</attribute>
            </xpath>
        </field>
    </record>
    <record id="view_move_form_commercial_lock" model="ir.ui.view">
        <field name="name">account.move.form.todopintura.lock</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_payment_term_id']" position="attributes">
                <attribute name="readonly">state in ['cancel', 'posted'] or todopintura_locked</attribute>
            </xpath>
            <xpath expr="//field[@name='payment_mode_id']" position="attributes">
                <attribute name="readonly">has_reconciled_items or todopintura_locked</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id'][1]" position="after">
                <field name="todopintura_locked" invisible="1"/>
            </xpath>
        </field>
    </record>

    <!-- Purchase history: read-only views over the existing order lines -->
    <record id="sale_order_line_history_list" model="ir.ui.view">
        <field name="name">sale.order.line.history.list</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" edit="0" default_order="order_id desc, id desc">
                <field name="order_id"/>
                <field name="product_id"/>
                <field name="product_uom_qty" string="Pedido" sum="Total"/>
                <field name="qty_delivered" string="Entregado" sum="Total"/>
                <field name="qty_invoiced" string="Facturado" sum="Total"/>
                <field name="price_unit"/>
                <field name="discount" optional="show"/>
                <field name="price_subtotal" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="sale_order_line_history_pivot" model="ir.ui.view">
        <field name="name">sale.order.line.history.pivot</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <pivot string="Historial de compras">
                <field name="product_id" type="row"/>
                <field name="qty_invoiced" type="measure"/>
                <field name="qty_delivered" type="measure"/>
                <field name="price_subtotal" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_order_form_purchase_history" model="ir.ui.view">
        <field name="name">sale.order.form.purchase.history</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_purchase_history" type="object" class="oe_stat_button"
                        icon="fa-history" string="Historial de compras" invisible="not partner_id"/>
            </xpath>
        </field>
    </record>
</odoo>

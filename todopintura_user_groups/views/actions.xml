<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Read-only customer views: only the ACL of the consulting groups allows reading,
         the primary views additionally remove create/edit/delete buttons. -->
    <record id="view_partner_list_readonly" model="ir.ui.view">
        <field name="name">res.partner.list.readonly</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="create">0</attribute>
                <attribute name="delete">0</attribute>
                <attribute name="import">0</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_partner_form_readonly" model="ir.ui.view">
        <field name="name">res.partner.form.readonly</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="create">0</attribute>
                <attribute name="edit">0</attribute>
                <attribute name="delete">0</attribute>
            </xpath>
        </field>
    </record>

    <record id="action_partners_consult" model="ir.actions.act_window">
        <field name="name">Consulta de clientes</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_partners_consult_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_partner_list_readonly"/>
        <field name="act_window_id" ref="action_partners_consult"/>
    </record>
    <record id="action_partners_consult_form" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_partner_form_readonly"/>
        <field name="act_window_id" ref="action_partners_consult"/>
    </record>

    <record id="action_partners_by_salesperson" model="ir.actions.act_window">
        <field name="name">Listado de clientes por vendedor y ventas</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('customer_rank', '>', 0)]</field>
        <field name="context">{'group_by': ['user_id']}</field>
    </record>

    <!-- Sales -->
    <record id="action_offers_consult" model="ir.actions.act_window">
        <field name="name">Consulta de ofertas</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="sale.sale_order_view_search_inherit_quotation"/>
        <field name="domain">[('state', 'in', ('draft', 'sent'))]</field>
    </record>

    <record id="action_credit_sales" model="ir.actions.act_window">
        <field name="name">Ventas a cuenta</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
        <field name="domain">[
            ('move_type', '=', 'out_invoice'),
            ('state', '=', 'posted'),
            ('payment_state', 'in', ('not_paid', 'partial')),
        ]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
    </record>
    <record id="action_credit_sales_list" model="ir.actions.act_window.view">
        <field name="sequence">1</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="account.view_out_invoice_tree"/>
        <field name="act_window_id" ref="action_credit_sales"/>
    </record>
    <record id="action_credit_sales_form" model="ir.actions.act_window.view">
        <field name="sequence">2</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="account.view_move_form"/>
        <field name="act_window_id" ref="action_credit_sales"/>
    </record>

    <!-- Stock -->
    <record id="action_internal_transfers_list" model="ir.actions.act_window">
        <field name="name">Listado de traspasos entre sucursales</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="stock.view_picking_internal_search"/>
        <field name="domain">[('picking_type_code', '=', 'internal')]</field>
        <field name="context">{'group_by': ['picking_type_id']}</field>
    </record>

    <record id="action_transfers_pending" model="ir.actions.act_window">
        <field name="name">Listado de traspasos pendientes de tiendas</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="stock.view_picking_internal_search"/>
        <field name="domain">[
            ('picking_type_code', '=', 'internal'),
            ('state', 'not in', ('done', 'cancel')),
        ]</field>
    </record>

    <record id="action_transfers_to_receive" model="ir.actions.act_window">
        <field name="name">Confirmación de recepción de artículos</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="stock.view_picking_internal_search"/>
        <field name="domain">[
            ('picking_type_code', 'in', ('incoming', 'internal')),
            ('state', 'in', ('confirmed', 'waiting', 'assigned')),
        ]</field>
    </record>

    <record id="action_product_barcodes" model="ir.actions.act_window">
        <field name="name">Mantenimiento de códigos de barras</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_product_search" model="ir.actions.act_window">
        <field name="name">Búsqueda de artículo</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,kanban,form</field>
    </record>

    <record id="action_stock_control_products" model="ir.actions.act_window">
        <field name="name">Listado de artículos para control de stock</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_storable', '=', True)]</field>
        <field name="context">{'group_by': ['categ_id']}</field>
    </record>

    <!-- Pricing -->
    <record id="action_pricelist_outlet" model="ir.actions.act_window">
        <field name="name">Ofertas clientes/outlets</field>
        <field name="res_model">product.pricelist</field>
        <field name="view_mode">list,form</field>
        <field name="domain" eval="[('id', '=', ref('pricelist_outlet'))]"/>
    </record>

    <!-- Statistical reports (standard sale.report with default grouping) -->
    <record id="action_report_sales_by_customer" model="ir.actions.act_window">
        <field name="name">Ventas por clientes</field>
        <field name="res_model">sale.report</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="sale.view_order_product_search"/>
        <field name="domain">[('state', '!=', 'cancel')]</field>
        <field name="context">{
            'pivot_row_groupby': ['partner_id'],
            'pivot_measures': ['price_subtotal'],
            'graph_groupbys': ['partner_id'],
        }</field>
    </record>

    <record id="action_report_sales_year_comparison" model="ir.actions.act_window">
        <field name="name">Comparativa de ventas de clientes entre dos años</field>
        <field name="res_model">sale.report</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="sale.view_order_product_search"/>
        <field name="domain">[('state', '!=', 'cancel')]</field>
        <field name="context">{
            'pivot_row_groupby': ['partner_id'],
            'pivot_column_groupby': ['date:year'],
            'pivot_measures': ['price_subtotal'],
            'graph_groupbys': ['date:year', 'partner_id'],
        }</field>
    </record>

    <record id="action_report_budget_status" model="ir.actions.act_window">
        <field name="name">Estado del presupuesto por comercial</field>
        <field name="res_model">sale.report</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="sale.view_order_product_search"/>
        <field name="domain">[('state', '!=', 'cancel')]</field>
        <field name="context">{
            'pivot_row_groupby': ['user_id'],
            'pivot_column_groupby': ['state'],
            'pivot_measures': ['price_subtotal'],
            'graph_groupbys': ['user_id', 'state'],
        }</field>
    </record>

    <record id="action_report_monthly_sales_by_customer" model="ir.actions.act_window">
        <field name="name">Venta mensual por cliente</field>
        <field name="res_model">sale.report</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="sale.view_order_product_search"/>
        <field name="domain">[('state', 'in', ('sale', 'done'))]</field>
        <field name="context">{
            'pivot_row_groupby': ['partner_id'],
            'pivot_column_groupby': ['date:month'],
            'pivot_measures': ['price_subtotal'],
            'graph_groupbys': ['date:month', 'partner_id'],
        }</field>
    </record>

    <record id="action_report_customer_sales_list" model="ir.actions.act_window">
        <field name="name">Listado de ventas de clientes</field>
        <field name="res_model">sale.report</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="sale.view_order_product_search"/>
        <field name="domain">[('state', 'in', ('sale', 'done'))]</field>
        <field name="context">{
            'group_by': ['partner_id'],
            'pivot_row_groupby': ['partner_id'],
            'pivot_measures': ['price_subtotal'],
        }</field>
    </record>

    <record id="action_report_sales_huelva" model="ir.actions.act_window">
        <field name="name">Ventas delegación Huelva</field>
        <field name="res_model">sale.report</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="sale.view_order_product_search"/>
        <field name="domain">[
            ('state', 'in', ('sale', 'done')),
            ('warehouse_id.name', 'ilike', 'Huelva'),
        ]</field>
        <field name="context">{
            'pivot_row_groupby': ['partner_id'],
            'pivot_column_groupby': ['date:month'],
            'pivot_measures': ['price_subtotal'],
            'graph_groupbys': ['date:month'],
        }</field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_pos_pricing" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.todopintura_base</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='pos_pricing_section']/setting[@id='multiple_prices_setting']" position="before">
                <setting string="Cargar todas las tarifas de precios" help="Cargar automáticamente todas las tarifas disponibles en el punto de venta">
                    <field name="pos_load_all_pricelists"/>
                </setting>
            </xpath>
            <xpath
                expr="//block[@id='pos_pricing_section']/setting[@id='multiple_prices_setting']/div[@class='content-group']"
                position="attributes">
                <attribute name="invisible">pos_load_all_pricelists</attribute>
            </xpath>
        </field>
    </record>
</odoo>

